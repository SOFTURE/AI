{
  "name": "@softure-ai/testing",
  "version": "0.6.0",
  "description": "SOFTURE AI test tools: a Vitest preset and setup file that pins the test time zone and shifts the test clock to TEST_TODAY, an opt-in happy-dom project for component interaction tests, Playwright helpers, a per-test client address and installed-app and phone checks (standalone, safe-area insets, phone network, offline, touch targets, a share from the share sheet) for black-box tests of an app, a scripted fake fetch, and source guards for architecture tests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/vitest/setup.ts",
    "./src/vitest/dom-setup.ts",
    "./dist/vitest/setup.js",
    "./dist/vitest/dom-setup.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "foundation/testing"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest-setup": {
      "@softure-ai/source": "./src/vitest/setup.ts",
      "types": "./dist/vitest/setup.d.ts",
      "default": "./dist/vitest/setup.js"
    },
    "./vitest-dom-setup": {
      "@softure-ai/source": "./src/vitest/dom-setup.ts",
      "types": "./dist/vitest/dom-setup.d.ts",
      "default": "./dist/vitest/dom-setup.js"
    },
    "./dom": {
      "@softure-ai/source": "./src/dom/index.ts",
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./playwright": {
      "@softure-ai/source": "./src/playwright/index.ts",
      "types": "./dist/playwright/index.d.ts",
      "default": "./dist/playwright/index.js"
    },
    "./guards": {
      "@softure-ai/source": "./src/guards/index.ts",
      "types": "./dist/guards/index.d.ts",
      "default": "./dist/guards/index.js"
    },
    "./guards/next": {
      "@softure-ai/source": "./src/guards/next/index.ts",
      "types": "./dist/guards/next/index.d.ts",
      "default": "./dist/guards/next/index.js"
    }
  },
  "peerDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": ">=10.0.0",
    "@testing-library/react": ">=16.0.0",
    "@testing-library/user-event": ">=14.0.0",
    "happy-dom": ">=20.0.0",
    "pg": "^8.11.0",
    "typescript": ">=5.0.0 <7.0.0",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@testing-library/dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
