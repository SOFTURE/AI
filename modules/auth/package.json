{
  "name": "@softure-ai/auth",
  "version": "0.1.12",
  "description": "SOFTURE AI auth module: users, scrypt passwords, database sessions, register with consent, login, logout, password change, roles, a proxy route guard, pages and forms for Next.js, and a password reset sender over @softure-ai/mailing.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "modules/auth"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "migrations",
    "module.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@softure-ai/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "@softure-ai/source": "./src/next/index.ts",
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./mailing": {
      "@softure-ai/source": "./src/mailing/index.ts",
      "types": "./dist/mailing/index.d.ts",
      "default": "./dist/mailing/index.js"
    },
    "./proxy": {
      "@softure-ai/source": "./src/proxy/index.ts",
      "types": "./dist/proxy/index.d.ts",
      "default": "./dist/proxy/index.js"
    },
    "./scripts": {
      "@softure-ai/source": "./src/scripts/index.ts",
      "types": "./dist/scripts/index.d.ts",
      "default": "./dist/scripts/index.js"
    },
    "./testing": {
      "@softure-ai/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./ui": {
      "@softure-ai/source": "./src/ui/index.ts",
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@softure-ai/core": "^0.1.8",
    "@softure-ai/db": "^0.1.0",
    "@softure-ai/security": "^0.1.8",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@softure-ai/mailing": "^0.1.0",
    "@softure-ai/ops": "^0.1.0",
    "@softure-ai/ui": "^0.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@softure-ai/ui": "^0.1.7"
  },
  "peerDependenciesMeta": {
    "@softure-ai/mailing": {
      "optional": true
    },
    "@softure-ai/ops": {
      "optional": true
    }
  }
}
