{
  "name": "@softure-ai/metering",
  "version": "0.3.0",
  "description": "SOFTURE AI metering module: a ledger of paid provider calls in any unit (credits, usd, characters, seconds, tokens, requests), budgets per provider and day or month that refuse a call before it spends, reservations under a lock, adapters for llm usage and footage charges, and a prune job.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "modules/metering"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "migrations",
    "module.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@softure-ai/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./jobs": {
      "@softure-ai/source": "./src/jobs/index.ts",
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@softure-ai/core": "^0.2.7",
    "@softure-ai/db": "^0.1.14",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@softure-ai/jobs": "^0.1.6",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependenciesMeta": {
    "@softure-ai/jobs": {
      "optional": true
    }
  }
}
