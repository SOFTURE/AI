{
  "id": "files",
  "version": "0.1.2",
  "dependsOn": { "jobs": "^0.1.6?", "security": "^0.2.5?" },
  "dbSchema": "files",
  "tables": ["files", "uploads"],
  "env": [
    {
      "name": "SOFTURE_FILES_LINK_KEYS",
      "required": false,
      "description": "Signing keyring for public file links: <id>:<base64 32 bytes>[,<id>:<key>...], the first one signs; needed only by createFileLink and the link route"
    }
  ],
  "switches": [],
  "routes": { "links": "/f", "uploads": "/u" },
  "mount": [
    {
      "kind": "route-handler",
      "path": "app/f/[...link]/route.ts",
      "export": "serveFileLinkRoute"
    },
    {
      "kind": "route-handler",
      "path": "app/u/[...upload]/route.ts",
      "export": "serveUploadRoute"
    }
  ],
  "privacy": { "exports": true, "deletes": true }
}
