{
  "name": "@softure-ai/feature-switches",
  "version": "0.0.0",
  "description": "SOFTURE AI feature switches module: switches declared by the app with defaults, a fail mode and environment overrides, isEnabled and setSwitch, and an admin-only panel for Next.js.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "modules/feature-switches"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "migrations",
    "module.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@softure-ai/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@softure-ai/auth": "^0.0.0",
    "@softure-ai/core": "^0.0.0",
    "@softure-ai/db": "^0.0.0",
    "@softure-ai/ui": "^0.0.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.0.0"
  }
}
