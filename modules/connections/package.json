{
  "name": "@softure-ai/connections",
  "version": "0.1.0",
  "description": "SOFTURE AI connections module: the app as an OAuth 2.0 client of third-party APIs and a store for their API keys. Providers from configuration, a connect flow for Next.js (one-time state, PKCE, a callback route) behind an admin-only page with each connection's status, tokens and keys encrypted at rest with AES-256-GCM under a rotating keyring, getAccessToken that refreshes under a lease (no double refresh across workers) and turns invalid_grant into a terminal reconnect_required state, a hook when a connection needs reconnecting, a privacy contributor, the softure-connections key and rotate-keys commands, and a fake provider for tests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "modules/connections"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "migrations",
    "module.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "softure-connections": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@softure-ai/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "@softure-ai/source": "./src/next/index.ts",
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./ui": {
      "@softure-ai/source": "./src/ui/index.ts",
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./testing": {
      "@softure-ai/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./cli": {
      "@softure-ai/source": "./src/cli/index.ts",
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@softure-ai/auth": "^0.2.0",
    "@softure-ai/core": "^0.2.0",
    "@softure-ai/db": "^0.1.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@softure-ai/ui": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@softure-ai/ui": "^0.3.0"
  }
}
