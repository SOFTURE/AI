{
  "id": "pwa",
  "version": "0.1.3",
  "dependsOn": {},
  "dbSchema": null,
  "tables": [],
  "env": [],
  "switches": [],
  "routes": { "manifest": "/pwa/manifest.webmanifest", "icons": "/pwa/icons", "version": "/pwa/version", "serviceWorker": "/sw.js" },
  "mount": [
    { "kind": "route-handler", "path": "app/pwa/manifest.webmanifest/route.ts", "export": "createManifestRoute" },
