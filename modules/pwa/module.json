{
  "id": "pwa",
  "version": "0.3.1",
  "runtimes": ["node", "workers"],
  "dependsOn": {},
  "dbSchema": null,
  "tables": [],
  "env": [
    {
      "name": "SOFTURE_BUILD_VERSION",
      "required": false,
      "description": "The build's version for the service worker; required on Cloudflare Workers, where there is no .next/BUILD_ID. Optional on Node."
    }
  ],
  "switches": [],
  "routes": { "manifest": "/pwa/manifest.webmanifest", "icons": "/pwa/icons", "version": "/pwa/version", "serviceWorker": "/sw.js" },
  "mount": [
    { "kind": "route-handler", "path": "app/pwa/manifest.webmanifest/route.ts", "export": "createManifestRoute" },
    { "kind": "route-handler", "path": "app/pwa/icons/[name]/route.ts", "export": "createIconRoute" },
    { "kind": "route-handler", "path": "app/pwa/version/route.ts", "export": "createVersionRoute" },
    { "kind": "route-handler", "path": "app/sw.js/route.ts", "export": "createServiceWorkerRoute" }
  ],
  "privacy": { "exports": false, "deletes": false }
}
