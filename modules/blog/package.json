{
  "name": "@softure-ai/blog",
  "version": "0.0.0",
  "description": "SOFTURE AI blog module: articles and glossary terms kept as Markdown files with a strict YAML frontmatter (extendable by the app's own fields), stored in the module's Postgres schema by the softure-blog publish command (dry run by default, all or nothing, content hash, slug history, one pillar per cluster), a server-side Markdown renderer (no raw HTML, safe links, glossary links, block plugins), a text quality gate (softure-blog check, run before every publish) with language rulesets and rule plugins, and the blog's pages ready to mount in Next.js (listing, article, glossary, method page, OG image, JSON-LD) with a proxy piece for 301 and 410.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "modules/blog"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "migrations",
    "module.json",
    "styles.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "softure-blog": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@softure-ai/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "@softure-ai/source": "./src/next/index.ts",
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./ui": {
      "@softure-ai/source": "./src/ui/index.ts",
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./proxy": {
      "@softure-ai/source": "./src/proxy/index.ts",
      "types": "./dist/proxy/index.d.ts",
      "default": "./dist/proxy/index.js"
    },
    "./cli": {
      "@softure-ai/source": "./src/cli/index.ts",
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@softure-ai/core": "^0.0.0",
    "@softure-ai/db": "^0.0.0",
    "@softure-ai/ui": "^0.0.0",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@softure-ai/seo": "^0.0.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@softure-ai/seo": "^0.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4"
  },
  "peerDependenciesMeta": {
    "@softure-ai/seo": {
      "optional": true
    }
  }
}
