{
  "name": "@softure-ai/waitlist",
  "version": "0.1.5",
  "description": "SOFTURE AI waitlist module: sign-ups with consent scopes and form placements from configuration, consent recorded in the privacy ledger, a welcome mail sent once through mailing, a rate-limited public action and a standalone WaitlistForm for Next.js.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "modules/waitlist"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "migrations",
    "module.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@softure-ai/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "@softure-ai/source": "./src/next/index.ts",
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./ui": {
      "@softure-ai/source": "./src/ui/index.ts",
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@softure-ai/auth": "^0.1.0",
    "@softure-ai/core": "^0.1.0",
    "@softure-ai/db": "^0.1.0",
    "@softure-ai/mailing": "^0.1.0",
    "@softure-ai/privacy": "^0.1.0",
    "@softure-ai/security": "^0.1.0",
    "@softure-ai/ui": "^0.1.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.0.0"
  }
}
