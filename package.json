{
  "name": "softure-ai",
  "private": true,
  "description": "SOFTURE AI — modular, tested building blocks for AI-assembled apps",
  "license": "MIT",
  "workspaces": [
    "foundation/*",
    "modules/*",
    "tools/*",
    "templates/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@softure-ai/skills": "^0.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "lefthook": "^2.1.16",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:code && npm run lint:language",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:code": "eslint . --max-warnings 0",
    "lint:language": "node scripts/check-language.mjs --all",
    "build": "node scripts/build-workspaces.mjs",
    "e2e": "node examples/next-app/scripts/e2e.mjs",
    "e2e:container": "node examples/next-app/scripts/container.mjs",
    "release:pack": "node scripts/release/pack.mjs",
    "release:version": "node scripts/release/version.mjs",
    "prepare": "node -e \"process.exit(process.env.CI?0:1)\" || lefthook install"
  }
}
