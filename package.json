{
  "name": "softure-ai",
  "private": true,
  "description": "SOFTURE AI \u2014 modular, tested building blocks for AI-assembled apps",
  "license": "MIT",
  "workspaces": [
    "foundation/*",
    "modules/*",
    "tools/*",
    "themes/*",
    "templates/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@softure-ai/skills": "^0.17.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/node": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^20.14.5",
    "lefthook": "^2.2.2",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:code && npm run lint:language",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "tsx scripts/test-changed.mjs",
    "lint:code": "eslint . --max-warnings 0",
    "lint:language": "tsx tools/config/src/cli/check-language.ts --all",
    "build": "node scripts/build-workspaces.mjs",
    "e2e": "node examples/next-app/scripts/e2e.mjs",
    "e2e:container": "node examples/next-app/scripts/container.mjs",
    "e2e:deploy-init": "node tools/deploy/scripts/init-image.mjs",
    "release:pack": "node scripts/release/pack.mjs",
    "release:version": "node scripts/release/version.mjs",
    "prepare": "node -e \"process.exit(process.env.CI?0:1)\" || lefthook install"
  }
}
