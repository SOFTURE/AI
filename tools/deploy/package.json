{
  "name": "@softure-ai/deploy",
  "version": "0.1.8",
  "description": "SOFTURE AI deploy CLI for a one-VPS app: renders .env.prod from CI secrets (names from the compose file), writes the release report between two tags, backs up the database, guards the migration ledger, compares row counts, verifies production against deploy.json, runs ops scripts and read-only SQL reports on the server and generates an app's deploy files once (init).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "tools/deploy"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "schema",
    "src",
    "templates",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "softure-deploy": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "schema": "tsx scripts/write-schema.ts",
    "e2e-app": "tsx scripts/write-e2e-app.ts"
  },
  "dependencies": {
    "@softure-ai/db": "^0.1.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@softure-ai/core": "^0.1.2",
    "tsx": "^4.23.0",
    "web-bot-auth": "^0.2.0"
  }
}
