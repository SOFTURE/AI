#!/usr/bin/env bash
# The server side of a release of {{name}}, generated by `softure-deploy init` (@softure-ai/deploy {{cliVersion}}).
# The app owns this file now; init never overwrites it without --force.
#
# The deploy workflow (SOFTURE/AI deploy-app.yml) connects with a key that authorized_keys binds to this script:
#
#   command="/srv/{{name}}/deploy.sh",restrict ssh-ed25519 AAAA… deploy@{{name}}
#
# so SSH_ORIGINAL_COMMAND is one of:
#
#   deploy <tag>   the release archive arrives on stdin (below)
#   status         read only: the live tag, the tag in .env.prod, the containers and the app's health
#   maintain       the daily cron's command (below)
#   maintain <hook>  a maintain hook with its own schedule (below)
#
# The release archive is a gzip tar of the tag's docker/prod/ (docker-compose.yml, traefik.yml and, with a database,
# initdb/), this script, deploy.json and the rendered .env.prod. It is unpacked into releases/<tag>/ and its files are
# installed next to this script in /srv/{{name}}/, so only the first setup copies this script there by hand. A new
# copy of this script is installed by a rename: the running copy finishes, the new one runs from the next release.
#
# The archive may also hold .registry-token, the deploy job's short-lived GITHUB_TOKEN: the image is then pulled
# with it through a Docker config in this run's temporary folder, so the host keeps no registry login and the token
# is never installed. Without it (the workflow's registry-token: false), the host's own registry login pulls
# {{image}}.
#
# The host needs Docker with the compose plugin, cron and flock (both in Ubuntu's base system).
{{#database}}
# The database steps run `@softure-ai/deploy` with Node.js 22 and pg_dump of the Postgres major version of the compose
# file: the host's (`npx`, postgresql-client-{{postgresVersion}}) when it has Node, otherwise a helper image this script
# builds once per CLI version from node:22-alpine with postgresql{{postgresVersion}}-client and the CLI
# ($TOOLS_IMAGE), run with the host's network, the caller's uid and this folder mounted. Nothing else needs Node.
# With database.access "compose-exec" in deploy.json, pg_dump and psql run in the postgres service instead (as
# POSTGRES_USER on POSTGRES_DB of .env.prod, for a Postgres that publishes no port) and the CLI only reads their output.
#
# Steps of a deploy: check the command, unpack and check the archive (archive), save the installed files and install
# the release's with .env.prod and TAG=<tag> in it (files), read the release's deploy.json (settings), pull the image
# (pull), start Postgres (postgres), back up the database (backup), guard the schema against the new image's migrations
# and, with database.appMigrations, its app journal against the app ledger (schema), count rows (row-counts-before),
# run the pre-migrate hooks, switch (switch: the migrate service runs before the app), recreate Traefik when its rules
# changed (traefik), compare the row counts (row-counts-after), record the tag (tag), install the cron (cron), run the
# post-up hooks. The tables counted are database.rowCountTables of the deploy.json this release shipped; without that
# file or key the counts are skipped. A changed postgres service takes effect at the postgres step, before the switch.
{{/database}}
{{^database}}
# The hooks of deploy.json need `@softure-ai/deploy` to read it: the host's `npx` when it has Node, otherwise a helper
# image built once per CLI version from node:22-alpine ($TOOLS_IMAGE). A release whose deploy.json has no hooks needs
# neither.
#
# Steps of a deploy: check the command, unpack and check the archive (archive), save the installed files and install
# the release's with .env.prod and TAG=<tag> in it (files), read the release's deploy.json hooks (settings), pull the
# image (pull), run the pre-migrate hooks, switch (switch), recreate Traefik when its rules changed (traefik), record the
# tag (tag), install the cron (cron), run the post-up hooks.
{{/database}}
#
# Hooks: deploy.json's "hooks" names app steps at three points, each a list of { "name", "compose": [args] } (run as
# docker compose --env-file .env.prod --file docker-compose.yml <args>) or { "name", "run": [argv] } (a command run here
# in this folder; a script the release ships is installed 0644, so run it through bash). pre-migrate runs before the
# switch (a failure puts the previous files back), post-up once the release is live (a failure fails the release and
# rolls nothing back), maintain in the daily maintain run, or with "schedule" on its own crontab line. Each gets TAG,
# IMAGE and PREVIOUS_TAG, prints `step|<name>|ok` when it succeeds, and its own output goes to stderr.
#
# Output: one line `step|<name>|ok[|<detail>]` per finished step on stdout (backup: the dump's file name; row counts:
# `<table>=<rows>,…`), and every deploy or maintain run ends with `result|ok` or `result|failed|<step>|<message>`; the
# workflow fails a release without `result|ok` and its report (DF-10) reads the details. Messages for people start
# with "deploy:".
#
# A step that fails before the switch puts the saved files and .env.prod back (Traefik's rules in place, so its bind
# mount keeps them) and removes what the release added; containers already started stay. From the switch on nothing
# is put back: the migrations may have run, and old files over a new schema are worse than a stopped release. A
# rollback is a redeploy of the previous tag ("Run workflow" in the app's deploy workflow); .env.prod.prev holds the
# .env.prod of the release before the last switch. Files a release no longer ships stay here.
#
# The cron: each release writes the crontab lines marked "# softure-deploy:{{name}}": one runs `maintain` daily (a
# backup with the release's retention, the newest BACKUP_KEEP and none older than BACKUP_MAX_AGE_DAYS, when there is a
# database, then the removal of this app's images whose release folder is gone and of dangling images, then the
# maintain hooks without a schedule), and one per scheduled maintain hook runs `maintain <hook>`. deploy and maintain
# never run at the same time (flock on .deploy.lock).
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="{{image}}"
DEPLOY_CLI="@softure-ai/deploy@{{cliVersion}}"
{{#database}}
TOOLS_IMAGE="softure-deploy-tools:{{cliVersion}}-pg{{postgresVersion}}"
{{/database}}
{{^database}}
TOOLS_IMAGE="softure-deploy-tools:{{cliVersion}}"
{{/database}}
{{#database}}
DATABASE_NAME="{{databaseName}}"
BACKUP_DIR="$APP_DIR/backups"
BACKUP_PREFIX=db
BACKUP_KEEP=7
# Deleted data must not outlive this many days in a backup.
BACKUP_MAX_AGE_DAYS=30
{{/database}}
TAG_FILE="$APP_DIR/.deployed-tag"
RELEASES_DIR="$APP_DIR/releases"
RELEASE_KEEP=5
MAX_ARCHIVE_BYTES=$((16 * 1024 * 1024))
LOCK_FILE="$APP_DIR/.deploy.lock"
# Below the deploy job's timeout, so a release waiting on a long maintain run still reports its result.
LOCK_WAIT_SECONDS=600
CRON_MARKER="# softure-deploy:{{name}}"
CRON_SCHEDULE="17 3 * * *"
HOOK_NAME_PATTERN='^[a-z][a-z0-9-]{0,39}$'
SCHEDULE_PATTERN='^[0-9*/,-]+( [0-9*/,-]+){4}$'
# Names this script keeps next to itself; a release archive must not carry them.
RESERVED_NAMES=(.env.prod.prev .deployed-tag .deploy.lock backups releases deploy.sh.new)

previous_tag="$(cat "$TAG_FILE" 2>/dev/null || true)"
command_name=""
current_step="command"
failure=""
reports_result="yes"
restore_armed=""
work=""
release_dir=""
# The settings of the deploy.json in use (load_settings).
settings_dir=""
{{#database}}
access="host"
app_journal=""
app_ledger=""
exclude_table_data=""
db_user=""
db_name=""
container=""
backup_file=""
{{/database}}

begin_step() {
  current_step="$1"
}

step_ok() {
  printf 'step|%s|ok%s\n' "$current_step" "${1:+|$1}"
}

fail() {
  failure="$1"
  echo "deploy: $1" >&2
  exit 1
}

refuse_command() {
  failure="$1"
  echo "deploy: $1" >&2
  exit 2
}

# Puts back what save_previous kept: files by cp onto the installed file (its inode, which a bind mount holds, stays),
# this script by a rename; then removes the files and folders the release added, deepest first.
restore_previous() {
  local path index restored="yes"
  local created=()
  while IFS= read -r -d '' path; do
    path="${path#./}"
    if [ "$path" = "deploy.sh" ]; then
      cp -p "$work/previous/deploy.sh" deploy.sh.new && mv -f deploy.sh.new deploy.sh || restored=""
    else
      mkdir -p "$(dirname "$path")" && cp -p "$work/previous/$path" "$path" || restored=""
    fi
  done < <(cd "$work/previous" && find . -type f -print0)
  while IFS= read -r -d '' path; do created+=("$path"); done < "$work/created"
  for ((index = ${#created[@]} - 1; index >= 0; index--)); do
    path="${created[index]}"
    if [ -d "$path" ]; then rmdir "$path" 2> /dev/null || true; else rm -f "$path" || restored=""; fi
  done
  if [ -n "$restored" ]; then
    echo "step|restore|ok"
    echo "deploy: the previous files and .env.prod are back in place." >&2
  else
    echo "step|restore|failed"
    echo "deploy: some previous files could not be put back; they are in releases/ of the previous tag." >&2
  fi
}

finish() {
  local status=$?
  set +e
{{#database}}
  if [ -n "$container" ]; then docker rm --force "$container" > /dev/null 2>&1; fi
{{/database}}
  if [ "$status" -ne 0 ] && [ -n "$restore_armed" ]; then restore_previous; fi
  if [ -n "$work" ]; then rm -rf "$work"; fi
  if [ -n "$reports_result" ]; then
    if [ "$status" -eq 0 ]; then
      echo "result|ok"
    else
      failure="${failure:-stopped with exit status $status}"
      printf 'result|failed|%s|%s\n' "$current_step" "${failure//$'\n'/ }"
      if [ "$command_name" = "deploy" ] && [ -n "$previous_tag" ]; then
        echo "deploy: the previous release is $previous_tag; redeploy it to roll back." >&2
      fi
    fi
  fi
  exit "$status"
}
trap finish EXIT

# Reads one value of .env.prod without sourcing it: `env render` writes NAME=value or NAME='value'.
read_env() {
  local line
  line="$(grep -m 1 "^$1=" .env.prod 2> /dev/null || true)"
  line="${line#*=}"
  line="${line#\'}"
  printf '%s' "${line%\'}"
}

compose() {
  docker compose --env-file .env.prod --file docker-compose.yml "$@"
}

take_lock() {
  begin_step lock
  exec 9> "$LOCK_FILE"
  if ! command -v flock > /dev/null; then fail "flock is missing on this host (util-linux)."; fi
  flock -w "$LOCK_WAIT_SECONDS" 9 || fail "another deploy or maintain run still holds $LOCK_FILE."
}

has_host_node() {
  command -v node > /dev/null && command -v npx > /dev/null
}

# The helper image for a host without Node: built on first use, then reused until the CLI version changes.
ensure_tools_image() {
  if docker image inspect "$TOOLS_IMAGE" > /dev/null 2>&1; then return 0; fi
  printf '%s\n' "FROM node:22-alpine" \
{{#database}}
    "RUN apk add --no-cache postgresql{{postgresVersion}}-client && npm install --global --no-audit --no-fund $DEPLOY_CLI" \
{{/database}}
{{^database}}
    "RUN npm install --global --no-audit --no-fund $DEPLOY_CLI" \
{{/database}}
    | docker build --quiet --tag "$TOOLS_IMAGE" - > /dev/null
}

# Runs a command in the helper image as the caller, on the host's network (Postgres listens on 127.0.0.1), with this
# folder and the run's temporary folder at the same paths. --stdin first hands this script's stdin to the command.
run_in_tools() {
  local options=(--rm --network host --user "$(id -u):$(id -g)" --env HOME=/tmp --env DATABASE_URL)
  if [ "$1" = "--stdin" ]; then
    options+=(--interactive)
    shift
  fi
  ensure_tools_image || return 1
  options+=(--volume "$APP_DIR:$APP_DIR")
  if [ -n "$work" ]; then options+=(--volume "$work:$work"); fi
  docker run "${options[@]}" --workdir "$PWD" "$TOOLS_IMAGE" "$@"
}

deploy_cli() {
  if has_host_node; then
    npx --yes "$DEPLOY_CLI" "$@"
  else
    run_in_tools softure-deploy "$@"
  fi
}

# The CLI reading this script's stdin (a dump or a snapshot piped in).
deploy_cli_stdin() {
  if has_host_node; then
    npx --yes "$DEPLOY_CLI" "$@"
  else
    run_in_tools --stdin softure-deploy "$@"
  fi
}

# Reads the settings of a deploy.json into $settings_dir through the CLI, which validates the file first. Without the
# file every setting keeps its default and no hook runs.
load_settings() {
  local config="$1"
  settings_dir="$work/settings"
  rm -rf "$settings_dir"
  mkdir -p "$settings_dir"
  if [ ! -f "$config" ]; then return 0; fi
{{^database}}
  # Without a database only the hooks need the CLI; a deploy.json without them is not read.
  if ! grep -q '"hooks"' "$config"; then return 0; fi
{{/database}}
  deploy_cli server-settings --config="$config" --out-dir="$settings_dir" > /dev/null || return 1
{{#database}}
  access="$(cat "$settings_dir/access")"
  app_journal="$(cat "$settings_dir/app-journal")"
  app_ledger="$(cat "$settings_dir/app-ledger")"
  exclude_table_data="$(cat "$settings_dir/exclude-table-data")"
  if [ "$access" != "host" ] && [ "$access" != "compose-exec" ]; then return 1; fi
{{/database}}
}

# Runs one hook from its record's fields, in this folder, with its output on stderr; prints its step line. Its stdin is
# /dev/null: run_hooks reads the records from stdin, and a hook that reads it (compose exec) would swallow the rest.
run_hook() {
  local name="$1" kind="$2"
  shift 2
  if [[ ! "$name" =~ $HOOK_NAME_PATTERN ]]; then fail "the hook name $name is not allowed."; fi
  begin_step "$name"
  local status=0
  case "$kind" in
    compose) compose "$@" < /dev/null >&2 || status=$? ;;
    run) (export TAG IMAGE PREVIOUS_TAG && "$@") < /dev/null >&2 || status=$? ;;
    *) fail "the hook $name has an unknown kind: $kind" ;;
  esac
  if [ "$status" -ne 0 ]; then fail "the hook $name failed with exit status $status."; fi
  step_ok
}

# Runs the hooks of a settings file (hooks-<point>, scheduled-<hook>) in their order: records of name, kind, argument
# count and arguments, NUL-separated.
run_hooks() {
  local file="$settings_dir/$1" name kind count arg index
  local args=()
  if [ -z "$settings_dir" ] || [ ! -s "$file" ]; then return 0; fi
  while IFS= read -r -d '' name; do
    IFS= read -r -d '' kind || fail "the hooks of $1 are cut short."
    IFS= read -r -d '' count || fail "the hooks of $1 are cut short."
    if [[ ! "$count" =~ ^[1-9][0-9]*$ ]]; then fail "the hooks of $1 are not readable."; fi
    args=()
    for ((index = 0; index < count; index++)); do
      IFS= read -r -d '' arg || fail "the hooks of $1 are cut short."
      args+=("$arg")
    done
    run_hook "$name" "$kind" "${args[@]}"
  done < "$file"
}
{{#database}}

# node -e <script> [args]: the host's Node, else the helper image's.
node_eval() {
  if has_host_node; then
    node -e "$@"
  else
    run_in_tools node -e "$@"
  fi
}

# host: the URL of the published Postgres for the CLI. compose-exec: the user and database psql and pg_dump use in the
# postgres service (POSTGRES_DB, else the image's default of POSTGRES_USER, else this app's database).
prepare_database() {
  if [ "$access" = "compose-exec" ]; then
    db_user="$(read_env POSTGRES_USER)"
    db_name="$(read_env POSTGRES_DB)"
    db_name="${db_name:-${db_user:-$DATABASE_NAME}}"
    db_user="${db_user:-postgres}"
    return 0
  fi
  local postgres_password
  postgres_password="$(read_env POSTGRES_PASSWORD)"
  if [ -z "$postgres_password" ]; then fail "POSTGRES_PASSWORD is missing in .env.prod."; fi
  export DATABASE_URL="postgresql://postgres:$postgres_password@127.0.0.1:5432/$DATABASE_NAME"
}

# One statement through psql in the postgres service; prints its one-line result.
db_psql() {
  compose exec -T postgres psql -X -q -v ON_ERROR_STOP=1 -At -U "$db_user" -d "$db_name" -c "$1"
}

# A statement the CLI prints (--print-query), run by psql in the postgres service and its result piped back into the
# CLI's --stdin mode: <command> <its flags…> -- <the --print-query flags…>.
run_on_snapshot() {
  local command="$1" query
  shift
  local flags=()
  while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
    flags+=("$1")
    shift
  done
  shift
  query="$(deploy_cli "$command" --print-query "$@")" || return 1
  db_psql "$query" | deploy_cli_stdin "$command" --stdin "${flags[@]}"
}

# Leaves the dump's file name in backup_file for the step line (the release report shows it, DF-10). compose-exec
# dumps into a hidden file first and hands it to the CLI only once pg_dump succeeded: a dump cut short must never
# become the newest backup.
back_up_database() {
  local output status=0 incoming table
  local retention=(--dir="$BACKUP_DIR" --prefix="$BACKUP_PREFIX" --keep="$BACKUP_KEEP" --max-age-days="$BACKUP_MAX_AGE_DAYS")
  if [ "$access" = "compose-exec" ]; then
    local exclusions=()
    if [ -n "$exclude_table_data" ]; then
      while IFS= read -r -d ',' table; do exclusions+=("--exclude-table-data=$table"); done <<< "$exclude_table_data,"
    fi
    mkdir -p "$BACKUP_DIR"
    incoming="$BACKUP_DIR/.incoming-$$.dump"
    if ! compose exec -T postgres pg_dump --format=custom --no-password -U "$db_user" -d "$db_name" ${exclusions[@]+"${exclusions[@]}"} > "$incoming"; then
      rm -f "$incoming"
      return 1
    fi
    output="$(deploy_cli_stdin backup --stdin "${retention[@]}" < "$incoming")" || status=$?
    rm -f "$incoming"
  else
    if [ -n "$exclude_table_data" ]; then retention+=(--exclude-table-data="$exclude_table_data"); fi
    output="$(deploy_cli backup "${retention[@]}")" || status=$?
  fi
  if [ -n "$output" ]; then printf '%s\n' "$output"; fi
  if [ "$status" -ne 0 ]; then return "$status"; fi
  backup_file="$(sed -n 's|^backup: wrote \(.*\) ([0-9]* bytes).*$|\1|p' <<< "$output")"
  backup_file="${backup_file##*/}"
}

# The guard over the image's exported migrations (and its app journal, when deploy.json names one) in $work.
guard_schema() {
  local guard=(--migrations-dir="$work/migrations")
  local query=()
  if [ -n "$app_ledger" ]; then
    guard+=(--app-journal="$work/app-journal.json" --app-ledger="$app_ledger")
    query+=(--app-ledger="$app_ledger")
  fi
  if [ "$access" = "compose-exec" ]; then
    run_on_snapshot schema-guard "${guard[@]}" -- ${query[@]+"${query[@]}"}
  else
    deploy_cli schema-guard "${guard[@]}"
  fi
}

# Row counts of the release's deploy.json tables: count_rows <flags…> (--out, --compare).
count_rows() {
  if [ "$access" = "compose-exec" ]; then
    run_on_snapshot row-counts --config="$release_config" "$@" -- --config="$release_config"
  else
    deploy_cli row-counts --config="$release_config" "$@"
  fi
}

# A row-counts file as `users=3,billing.plans=2` for the step line; table names never hold `,` or `=`.
summarize_counts() {
  node_eval '
const counts = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).counts;
process.stdout.write(Object.entries(counts).map(([table, count]) => table + "=" + count).join(","));
' "$1" || true
}
{{/database}}

# The forced command: one line, split on blanks without expansion.
command_line="${SSH_ORIGINAL_COMMAND:-}"
if [[ "$command_line" == *$'\n'* ]] || [[ "$command_line" == *$'\r'* ]]; then
  refuse_command "expected one command line: \"deploy <tag>\", \"status\" or \"maintain [<hook>]\"."
fi
read -r -a words <<< "$command_line"
command_name="${words[0]:-}"
case "$command_name:${#words[@]}" in
  deploy:2 | status:1 | maintain:1 | maintain:2) ;;
  *) refuse_command "expected the command \"deploy <tag>\", \"status\" or \"maintain [<hook>]\"." ;;
esac
if [ "$command_name" = "maintain" ] && [ "${#words[@]}" -eq 2 ] && [[ ! "${words[1]}" =~ $HOOK_NAME_PATTERN ]]; then
  refuse_command "the hook name is not a lower-case word of letters, digits and -."
fi

cd "$APP_DIR"
umask 077

# ── status ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# Read only: no lock, no file written, no result line.
if [ "$command_name" = "status" ]; then
  reports_result=""
  env_tag=""
  containers=""
  health=""
  if [ -f .env.prod ]; then
    env_tag="$(read_env TAG)"
    containers="$(compose ps --all --format '{{.Service}}:{{.Status}}' 2> /dev/null | tr '\n' ' ' || true)"
    app_container="$(compose ps --quiet app 2> /dev/null || true)"
    if [ -n "$app_container" ]; then
      health="$(docker inspect --format '{{.State.Health.Status}}' "$app_container" 2> /dev/null || true)"
    fi
  fi
  containers="${containers% }"
  printf 'status|tag|%s\n' "${previous_tag:-none}"
  printf 'status|env-tag|%s\n' "${env_tag:-none}"
  printf 'status|containers|%s\n' "${containers:-none}"
  printf 'status|health|%s\n' "${health:-none}"
  exit 0
fi

# ── maintain ────────────────────────────────────────────────────────────────────────────────────────────────────────
if [ "$command_name" = "maintain" ]; then
  take_lock
  begin_step env
  if [ ! -f .env.prod ]; then fail "nothing is deployed here yet."; fi
  # TAG of the live release, for the compose file's interpolation.
  TAG="$(read_env TAG)"
  PREVIOUS_TAG="$previous_tag"
  export TAG
  work="$(mktemp -d)"

  # The deploy.json the live release installed.
  begin_step settings
  load_settings "$APP_DIR/deploy.json" || fail "cannot read deploy.json, or it is not valid; nothing was run."
  step_ok

  # maintain <hook>: only that scheduled hook, on its own crontab line.
  if [ "${#words[@]}" -eq 2 ]; then
    if [ ! -s "$settings_dir/scheduled-${words[1]}" ]; then fail "deploy.json has no scheduled maintain hook ${words[1]}."; fi
    run_hooks "scheduled-${words[1]}"
    exit 0
  fi
{{#database}}

  begin_step backup
  prepare_database
  back_up_database || fail "the backup failed."
  step_ok "$backup_file"
{{/database}}

  # This app's image tags without a release folder go (the newest RELEASE_KEEP stay, so a rollback to them needs no
  # pull); a tag a container still uses is refused by Docker and stays. Then the dangling images of the host.
  begin_step images
  image_tags="$(docker image ls "$IMAGE" --format '{{.Tag}}')" || fail "cannot list the images of $IMAGE."
  removed=0
  while IFS= read -r image_tag; do
    if [ -z "$image_tag" ] || [ "$image_tag" = "<none>" ] || [ "$image_tag" = "$TAG" ]; then continue; fi
    if [[ ! "$image_tag" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] || [ -d "$RELEASES_DIR/$image_tag" ]; then continue; fi
    if docker image rm "$IMAGE:$image_tag" > /dev/null 2>&1; then removed=$((removed + 1)); fi
  done <<< "$image_tags"
  docker image prune --force > /dev/null || fail "cannot remove the dangling images."
  step_ok "removed $removed"

  run_hooks hooks-maintain
  exit 0
fi

# ── deploy <tag> ────────────────────────────────────────────────────────────────────────────────────────────────────
TAG="${words[1]}"
if [[ ! "$TAG" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]]; then
  refuse_command "the tag is not a Docker tag (letters, digits, _ . -; at most 128)."
fi
export TAG

take_lock

begin_step archive
work="$(mktemp -d)"

# A refused archive leaves no release folder and installs nothing.
refuse() {
  if [ -n "$release_dir" ]; then rm -rf "$release_dir"; fi
  fail "$1"
}

# Regular files and folders only, each name in a narrow pattern without a .. segment: tar itself would follow a
# symlink member out of the release folder.
check_archive() {
  local listing name
  listing="$(tar -tvzf "$1" 2> /dev/null)" || refuse "the release archive cannot be read."
  if grep -qv '^[-d]' <<< "$listing"; then refuse "the release archive holds something other than files and folders."; fi
  while IFS= read -r name; do
    if [[ ! "$name" =~ ^(\./)?([A-Za-z0-9_.][A-Za-z0-9_.-]*/?)*$ ]] || [[ "/$name/" == */../* ]]; then
      refuse "the release archive holds a path that is not allowed: $name"
    fi
  done < <(tar -tzf "$1")
}

# Keeps a copy of every installed file the release is about to replace, and lists what it is about to add.
save_previous() {
  local path
  mkdir -p "$work/previous"
  : > "$work/created"
  while IFS= read -r -d '' path; do
    path="${path#./}"
    if [ -e "$path" ]; then
      if [ -f "$path" ]; then
        if ! mkdir -p "$work/previous/$(dirname "$path")" || ! cp -p "$path" "$work/previous/$path"; then
          fail "cannot save $path before the install."
        fi
      fi
    else
      printf '%s\0' "$path" >> "$work/created"
    fi
  done < <(cd "$release_dir" && find . -mindepth 1 -print0)
}

# Copies the release's files next to this script. cp onto an existing file keeps its inode, which a running
# container's bind mount (Traefik's rules) holds; this script is replaced by a rename instead, so the running copy
# keeps reading its own file. Containers read the files as another user: 0644 and 0755.
rules_changed=""
install_release() {
  local path
  while IFS= read -r -d '' path; do
    path="${path#./}"
    if [ "$path" = "deploy.sh" ]; then continue; fi
    if [ -d "$release_dir/$path" ]; then
      if ! mkdir -p "$path" || ! chmod 0755 "$path"; then fail "cannot install the folder $path."; fi
      continue
    fi
    if ! cmp -s "$release_dir/$path" "$path"; then
      # On the first release Traefik starts with the rules; later it may run on the old ones.
      if [ "$path" = "traefik.yml" ] && [ -e "$path" ]; then rules_changed="yes"; fi
      cp "$release_dir/$path" "$path" || fail "cannot install $path."
    fi
    chmod 0644 "$path"
  done < <(cd "$release_dir" && find . -mindepth 1 -print0)
  if ! cp "$release_dir/deploy.sh" deploy.sh.new || ! chmod 0755 deploy.sh.new || ! mv -f deploy.sh.new deploy.sh; then
    fail "cannot install deploy.sh."
  fi
}

archive="$work/release.tar.gz"
head -c "$((MAX_ARCHIVE_BYTES + 1))" > "$archive"
archive_bytes="$(wc -c < "$archive")"
if [ "$archive_bytes" -eq 0 ]; then fail "no release archive arrived on stdin."; fi
if [ "$archive_bytes" -gt "$MAX_ARCHIVE_BYTES" ]; then fail "the release archive is larger than $MAX_ARCHIVE_BYTES bytes."; fi
check_archive "$archive"

release_dir="$RELEASES_DIR/$TAG"
rm -rf "$release_dir"
mkdir -p "$release_dir"
tar -xzf "$archive" -C "$release_dir" --no-same-owner --no-same-permissions || refuse "the release archive cannot be unpacked."
for required in .env.prod deploy.sh docker-compose.yml; do
  if [ ! -s "$release_dir/$required" ]; then refuse "the release archive has no $required."; fi
done
for reserved in "${RESERVED_NAMES[@]}"; do
  if [ -e "$release_dir/$reserved" ]; then refuse "the release archive holds $reserved, a name this server keeps for itself."; fi
done
registry_token=""
if [ -e "$release_dir/.registry-token" ]; then
  if [ ! -f "$release_dir/.registry-token" ] || [ ! -s "$release_dir/.registry-token" ]; then
    refuse "the release archive's .registry-token is empty or not a file."
  fi
  registry_token="$work/registry-token"
  mv -f "$release_dir/.registry-token" "$registry_token"
fi
docker compose --env-file "$release_dir/.env.prod" --file "$release_dir/docker-compose.yml" config --quiet \
  || refuse "the compose file of $TAG is not valid; nothing was installed."
step_ok

begin_step files
save_previous
restore_armed="yes"
# The tag goes into .env.prod, so a docker compose by hand or from the cron runs the live release.
{ grep -v '^TAG=' "$release_dir/.env.prod" || true; printf 'TAG=%s\n' "$TAG"; } > "$release_dir/.env.prod.tagged"
rm -f "$release_dir/.env.prod"
mv -f "$release_dir/.env.prod.tagged" .env.prod
chmod 0600 .env.prod
install_release
# The newest RELEASE_KEEP release folders stay. Their names are tags (the pattern above), so ls is safe here.
# shellcheck disable=SC2012
while IFS= read -r old; do rm -rf "${RELEASES_DIR:?}/$old"; done < <(ls -1t "$RELEASES_DIR" | tail -n "+$((RELEASE_KEEP + 1))")
step_ok

# The release's own deploy.json, validated before anything else changes; a bad file puts the previous files back.
PREVIOUS_TAG="$previous_tag"
begin_step settings
load_settings "$release_dir/deploy.json" || fail "cannot read the release's deploy.json, or it is not valid; nothing was restarted."
step_ok

echo "deploy: $IMAGE:$TAG (previous: ${previous_tag:-none})"
begin_step pull
if [ -n "$registry_token" ]; then
  registry="${IMAGE%%/*}"
  mkdir -p "$work/docker-config"
  DOCKER_CONFIG="$work/docker-config" docker login "$registry" --username softure-deploy --password-stdin \
    < "$registry_token" > /dev/null || fail "cannot log in to $registry with the release's registry token."
  DOCKER_CONFIG="$work/docker-config" docker pull --quiet "$IMAGE:$TAG" > /dev/null || fail "cannot pull $IMAGE:$TAG."
else
  docker pull --quiet "$IMAGE:$TAG" > /dev/null || fail "cannot pull $IMAGE:$TAG."
fi
step_ok
{{#database}}

# Postgres must run before its first backup; on the first release it starts here and creates the roles.
begin_step postgres
prepare_database
compose up --detach --wait postgres || fail "Postgres did not become healthy."
step_ok

begin_step backup
back_up_database || fail "the backup failed; nothing was restarted."
step_ok "$backup_file"

begin_step schema
container="$(docker create "$IMAGE:$TAG")"
docker cp "$container:/app/softure-migrations" "$work/migrations" > /dev/null
if [ -n "$app_journal" ]; then
  docker cp "$container:$app_journal" "$work/app-journal.json" > /dev/null 2>&1 \
    || fail "the image $TAG has no $app_journal (database.appMigrations.journal); nothing was restarted."
fi
guard_schema || fail "the schema guard refused $TAG; nothing was restarted."
step_ok

# The tables whose row count must not drop: database.rowCountTables of the deploy.json this release shipped, not the
# copy next to this script, which an older release may have left. Exit 0: a list; 3: no file or no list.
begin_step row-counts-before
release_config="$release_dir/deploy.json"
lists_tables=0
node_eval '
const fs = require("node:fs");
const path = process.argv[1];
if (!fs.existsSync(path)) process.exit(3);
const tables = JSON.parse(fs.readFileSync(path, "utf8"))?.database?.rowCountTables;
process.exit(Array.isArray(tables) && tables.length > 0 ? 0 : 3);
' "$release_config" || lists_tables=$?
if [ "$lists_tables" -ne 0 ] && [ "$lists_tables" -ne 3 ]; then
  fail "cannot read the row-count tables of the release's deploy.json."
fi

# The first release has no rows to lose (and no tables yet). A listed table the old schema lacks counts as absent, so
# it may join the list in the release whose migration creates it.
counted=""
if [ "$lists_tables" -eq 0 ] && [ -n "$previous_tag" ]; then
  count_rows --out="$work/counts-before.json" || fail "counting rows failed; nothing was restarted."
  counted="yes"
  step_ok "$(summarize_counts "$work/counts-before.json")"
else
  step_ok "skipped"
fi
{{/database}}

# The app's steps before the switch; a failure still puts the previous files back.
run_hooks hooks-pre-migrate

# From here nothing is put back (see the header); the .env.prod this release replaced becomes .env.prod.prev.
begin_step switch
if [ -f "$work/previous/.env.prod" ]; then
  cp -p "$work/previous/.env.prod" .env.prod.prev
  chmod 0600 .env.prod.prev
fi
restore_armed=""
compose up --detach --wait --remove-orphans traefik app || fail "the stack did not become healthy on $TAG."
step_ok

# A running Traefik that the switch did not recreate keeps its old rules: a bind-mounted file is read at the start.
if [ -n "$rules_changed" ]; then
  begin_step traefik
  compose up --detach --wait --force-recreate traefik || fail "Traefik did not start again with the new rules."
  step_ok
fi
{{#database}}

if [ -n "$counted" ]; then
  begin_step row-counts-after
  count_rows --compare="$work/counts-before.json" --out="$work/counts-after.json" \
    || fail "rows were lost on $TAG; the backup before it is the newest in $BACKUP_DIR."
  step_ok "$(summarize_counts "$work/counts-after.json")"
fi
{{/database}}

begin_step tag
printf '%s\n' "$TAG" > "$TAG_FILE"
step_ok

# The lines of this app in the crontab, rewritten by every release; other lines stay as they are.
begin_step cron
if [[ ! "$APP_DIR" =~ ^/[A-Za-z0-9_./-]+$ ]]; then fail "the app folder cannot go into a crontab line: $APP_DIR; $TAG is live."; fi
# "no crontab for <user>" is an empty table; any other error must not lead to a table without the other lines.
if ! current_crontab="$(crontab -l 2> "$work/crontab-error")"; then
  if ! grep -q "no crontab" "$work/crontab-error"; then fail "cannot read the crontab; $TAG is live."; fi
  current_crontab=""
fi
{
  if [ -n "$current_crontab" ]; then grep -v " $CRON_MARKER\$" <<< "$current_crontab" || true; fi
  printf '%s PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin SSH_ORIGINAL_COMMAND=maintain %s/deploy.sh 2>&1 | logger -t %s-maintain %s\n' \
    "$CRON_SCHEDULE" "$APP_DIR" "{{name}}" "$CRON_MARKER"
  # A maintain hook with its own schedule: name and schedule from server-settings, checked again before either reaches
  # the line.
  if [ -s "$settings_dir/cron" ]; then
    while IFS= read -r -d '' hook_name && IFS= read -r -d '' hook_schedule; do
      if [[ ! "$hook_name" =~ $HOOK_NAME_PATTERN ]] || [[ ! "$hook_schedule" =~ $SCHEDULE_PATTERN ]]; then
        fail "the scheduled hook $hook_name cannot go into a crontab line; $TAG is live."
      fi
      printf "%s PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin SSH_ORIGINAL_COMMAND='maintain %s' %s/deploy.sh 2>&1 | logger -t %s-%s %s\n" \
        "$hook_schedule" "$hook_name" "$APP_DIR" "{{name}}" "$hook_name" "$CRON_MARKER"
    done < "$settings_dir/cron"
  fi
} > "$work/crontab" || fail "cannot write the crontab lines of $TAG's scheduled hooks; $TAG is live."
crontab - < "$work/crontab" || fail "cannot install the maintenance cron; $TAG is live."
step_ok

# The app's steps once the release is live; a failure fails the release and rolls nothing back.
run_hooks hooks-post-up

echo "deploy: $TAG is live."
