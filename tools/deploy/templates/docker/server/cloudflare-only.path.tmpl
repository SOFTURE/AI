# Re-applies {{name}}'s Cloudflare-only firewall rules when the ranges file changes, generated by
# `softure-deploy init --cdn=cloudflare` (@softure-ai/deploy {{cliVersion}}). Install steps: the header of
# cloudflare-only.sh.
[Unit]
Description=Cloudflare ranges of {{name}} changed

[Path]
PathChanged=/srv/{{name}}/cloudflare-ips.txt
Unit={{name}}-cloudflare-only.service

[Install]
WantedBy=multi-user.target
