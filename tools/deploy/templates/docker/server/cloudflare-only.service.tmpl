# Applies {{name}}'s Cloudflare-only firewall rules (/usr/local/sbin/{{name}}-cloudflare-only), generated by
# `softure-deploy init --cdn=cloudflare` (@softure-ai/deploy {{cliVersion}}). Runs whenever Docker starts, and again
# through {{name}}-cloudflare-only.path whenever the release's hook rewrites the ranges. Install steps: the header of
# cloudflare-only.sh.
[Unit]
Description=Cloudflare-only access to {{name}} on ports 80 and 443
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/{{name}}-cloudflare-only

[Install]
WantedBy=docker.service
