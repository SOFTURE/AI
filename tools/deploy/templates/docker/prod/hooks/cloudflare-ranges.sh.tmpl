# Refreshes the Cloudflare ranges of {{name}}'s firewall, generated by `softure-deploy init --cdn=cloudflare`
# (@softure-ai/deploy {{cliVersion}}). The app owns this file now; init never overwrites it without --force.
#
# deploy.json runs it after every release (post-up hook cloudflare-ranges) and in the daily maintain run
# (cloudflare-ranges-daily), as the deploy user in /srv/{{name}}/. It downloads Cloudflare's IPv4 and IPv6 lists and
# writes them to cloudflare-ips.txt, one CIDR per line, only when they changed; root's
# {{name}}-cloudflare-only.path unit sees the change and re-applies the firewall (docker/server/cloudflare-only.sh).
#
# A list with a line that is not a CIDR, a /0, or no IPv4 range is refused. A download that fails keeps the ranges
# already there (a warning), and fails the hook only when there are none yet. A range missing from Traefik's
# forwardedHeaders.trustedIPs is a warning: copy the new list there.
#
# Traefik reads its static configuration from one source. By default the hook looks for trustedIPs in the compose
# file's --entrypoints.*.forwardedHeaders.trustedIPs flags. An app that keeps it in a file instead names that file,
# relative to the app folder, in both hooks' "run" of deploy.json:
#
#   ["bash", "hooks/cloudflare-ranges.sh", "--traefik-static-config", "traefik/traefik.yml"]
#
# YAML (block or flow lists) and TOML (arrays) are read; every trustedIPs list there must hold every range.
set -euo pipefail
. hooks/lib.sh

RANGES_FILE=cloudflare-ips.txt
COMPOSE_FILE=docker-compose.yml
STATIC_CONFIG=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --traefik-static-config)
      if [ "$#" -lt 2 ] || [ -z "$2" ]; then fail "--traefik-static-config needs a path relative to the app folder."; fi
      STATIC_CONFIG="$2"
      shift 2
      ;;
    *) fail "unknown argument $1; the only one is --traefik-static-config <path>." ;;
  esac
done
SOURCE="${CLOUDFLARE_IPS_URL:-https://www.cloudflare.com}"
IPV4_RANGE='^([0-9]{1,3}\.){3}[0-9]{1,3}/([1-9]|[12][0-9]|3[0-2])$'
IPV6_RANGE='^[0-9a-fA-F:]*:[0-9a-fA-F:]*/([1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$'

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Downloads one list (4 or 6) into $work/v<family>; false when the download fails.
download() {
  curl --fail --silent --show-error --max-time 30 --output "$work/v$1" "$SOURCE/ips-v$1"
}

if ! download 4 || ! download 6; then
  if [ -s "$RANGES_FILE" ]; then
    echo "hook: warning: cannot download Cloudflare's ranges; $RANGES_FILE stays as it is." >&2
    exit 0
  fi
  fail "cannot download Cloudflare's ranges, and there are none in $RANGES_FILE yet."
fi

ipv4_count=0
: > "$work/ranges"
for family in 4 6; do
  while IFS= read -r range || [ -n "$range" ]; do
    range="${range%$'\r'}"
    if [ -z "$range" ]; then continue; fi
    if [ "$family" = 4 ] && [[ "$range" =~ $IPV4_RANGE ]]; then
      ipv4_count=$((ipv4_count + 1))
    elif [ "$family" != 6 ] || [[ ! "$range" =~ $IPV6_RANGE ]]; then
      fail "Cloudflare's IPv$family list holds a line that is not an allowed CIDR range: $range"
    fi
    printf '%s\n' "$range" >> "$work/ranges"
  done < "$work/v$family"
done
if [ "$ipv4_count" -eq 0 ]; then fail "Cloudflare's IPv4 list is empty; $RANGES_FILE stays as it is."; fi

if [ -f "$RANGES_FILE" ] && cmp -s "$work/ranges" "$RANGES_FILE"; then
  echo "hook: Cloudflare's ranges unchanged ($(wc -l < "$RANGES_FILE" | tr -d ' ') in $RANGES_FILE)." >&2
else
  # A rename, so the firewall never reads a half-written file.
  cp "$work/ranges" "$RANGES_FILE.tmp"
  chmod 0644 "$RANGES_FILE.tmp"
  mv -f "$RANGES_FILE.tmp" "$RANGES_FILE"
  echo "hook: wrote $(wc -l < "$RANGES_FILE" | tr -d ' ') Cloudflare ranges to $RANGES_FILE." >&2
fi

# Prints the ranges of $RANGES_FILE missing from the comma-separated list $1, each after a space.
missing_from() {
  local trusted=",$1," range missing=""
  while IFS= read -r range; do
    case "$trusted" in
      *",$range,"*) ;;
      *) missing="$missing $range" ;;
    esac
  done < "$RANGES_FILE"
  printf '%s' "$missing"
}

# Prints every trustedIPs list of a YAML or TOML file, one per line, its entries joined by commas: a YAML block list
# (the "- " lines under the key), a YAML flow list or a TOML array, on one line or several. Comments are dropped.
static_trusted_lists() {
  awk '
    function emit() {
      gsub(/[][ \t"\047]+/, ",", list)
      gsub(/,,+/, ",", list)
      sub(/^,/, "", list)
      sub(/,$/, "", list)
      print list
      list = ""
    }
    {
      line = $0
      sub(/\r$/, "", line)
      sub(/#.*/, "", line)
      if (in_block) {
        if (line ~ /^[[:space:]]*-/) { sub(/^[[:space:]]*-/, "", line); list = list "," line; next }
        if (line ~ /^[[:space:]]*$/) next
        in_block = 0
        emit()
      }
      if (in_array) {
        list = list "," line
        if (line ~ /\]/) { in_array = 0; emit() }
        next
      }
      if (line ~ /(^|[^A-Za-z0-9_])trustedIPs["\047]?[[:space:]]*[:=]/) {
        rest = line
        sub(/.*trustedIPs["\047]?[[:space:]]*[:=]/, "", rest)
        list = rest
        if (rest ~ /^[[:space:]]*$/) in_block = 1
        else if (rest ~ /\[/ && rest !~ /\]/) in_array = 1
        else emit()
      }
    }
    END { if (in_block || in_array) emit() }
  ' "$1"
}

if [ -n "$STATIC_CONFIG" ]; then
  if [ ! -f "$STATIC_CONFIG" ] || [ ! -r "$STATIC_CONFIG" ]; then
    echo "hook: warning: the Traefik static config $STATIC_CONFIG is not a readable file; its trustedIPs are not checked." >&2
    exit 0
  fi
  lists="$(static_trusted_lists "$STATIC_CONFIG")"
  if [ -z "$lists" ]; then
    echo "hook: warning: $STATIC_CONFIG has no forwardedHeaders.trustedIPs; add Cloudflare's ranges there." >&2
    exit 0
  fi
  missing=""
  while IFS= read -r list; do
    for range in $(missing_from "$list"); do
      case " $missing " in
        *" $range "*) ;;
        *) missing="$missing $range" ;;
      esac
    done
  done <<< "$lists"
  if [ -n "$missing" ]; then
    echo "hook: warning: forwardedHeaders.trustedIPs in $STATIC_CONFIG lacks Cloudflare's$missing; add them there." >&2
  fi
elif [ -f "$COMPOSE_FILE" ] && grep -q 'forwardedHeaders.trustedIPs=' "$COMPOSE_FILE"; then
  trusted="$(grep -o 'forwardedHeaders.trustedIPs=[^[:space:]"]*' "$COMPOSE_FILE" | head -n 1)"
  missing="$(missing_from "${trusted#*=}")"
  if [ -n "$missing" ]; then
    echo "hook: warning: forwardedHeaders.trustedIPs in $COMPOSE_FILE lacks Cloudflare's$missing; add them there." >&2
  fi
fi
