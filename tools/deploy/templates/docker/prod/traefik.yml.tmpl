# Traefik rules of {{name}} (file provider), generated by `softure-deploy init` (@softure-ai/deploy {{cliVersion}}).
# The app owns this file now; init never overwrites it without --force. Traefik reloads it on change.
#
# The apex router serves {{domain}}{{pathsNote}}; any other host or path gets Traefik's 404.
http:
  routers:
    app:
      rule: "{{appRule}}"
      entryPoints: [websecure]
      service: app
      middlewares: [security-headers]
      tls:
        certResolver: letsencrypt
{{#www}}
    www:
      rule: "Host(`www.{{domain}}`)"
      entryPoints: [websecure]
      service: noop@internal
      middlewares: [www-to-apex]
      tls:
        certResolver: letsencrypt
{{/www}}

  middlewares:
    security-headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        contentTypeNosniff: true
        referrerPolicy: strict-origin-when-cross-origin
{{#www}}
    www-to-apex:
      redirectRegex:
        regex: "^https?://www\\.{{domainPattern}}/(.*)"
        replacement: "https://{{domain}}/${1}"
        permanent: true
{{/www}}

  services:
    app:
      loadBalancer:
        servers:
          - url: http://app:3000
