# Production stack of {{name}} on one VPS, generated by `softure-deploy init` (@softure-ai/deploy {{cliVersion}}).
# The app owns this file now; init never overwrites it without --force.
#
# docker/server/deploy.sh runs it on the server as `docker compose --env-file .env.prod up -d --wait`, with TAG set
# to the release tag. Every variable below in the required form (a dollar, a brace, the name, then :?) is a
# secret: the deploy workflow renders exactly these names into .env.prod with `softure-deploy env render`, so this
# file stays the one list of what production needs. A comment must not spell that form out: it would count too.
{{#database}}
# Passwords go into connection URLs as they are: use URL-safe values, e.g. `openssl rand -hex 32`.
{{/database}}
{{#edge}}
#
# This stack runs no Traefik: the app joins the external network {{edgeNetwork}} of the Traefik another stack on this
# server runs (init --edge), and its labels publish it there. That Traefik needs the Docker provider
# (exposedByDefault=false), the entry point websecure and the certificate resolver letsencrypt.
{{/edge}}
name: {{name}}

services:
{{^edge}}
  traefik:
    image: traefik:{{traefikVersion}}
    restart: unless-stopped
    command:
      - --providers.file.filename=/etc/traefik/rules.yml
      - --providers.file.watch=true
      - --entrypoints.web.address=:80
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --entrypoints.websecure.address=:443
      - --certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web
      - --certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json
{{#hasAcmeEmail}}
      - --certificatesresolvers.letsencrypt.acme.email={{acmeEmail}}
{{/hasAcmeEmail}}
{{#cloudflare}}
      # Behind Cloudflare (init --cdn=cloudflare): X-Forwarded-For and X-Real-IP are kept from Cloudflare's ranges
      # only. hooks/cloudflare-ranges.sh warns when Cloudflare publishes a range missing here.
      - --entrypoints.web.forwardedHeaders.trustedIPs={{cloudflareRanges}}
      - --entrypoints.websecure.forwardedHeaders.trustedIPs={{cloudflareRanges}}
{{/cloudflare}}
      - --log.level=WARN
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./traefik.yml:/etc/traefik/rules.yml:ro
      - letsencrypt:/letsencrypt

{{/edge}}
  app:
    image: {{image}}:${TAG}
    restart: unless-stopped
    environment:
      APP_ORIGIN: https://{{domain}}
{{#database}}
      DATABASE_URL: postgresql://softure_app:${SOFTURE_APP_PASSWORD:?}@postgres:5432/{{databaseName}}
{{/database}}
{{#hasAppEnv}}
{{appEnvLines}}
{{/hasAppEnv}}
{{#database}}
    depends_on:
      migrate:
        condition: service_completed_successfully
{{/database}}
{{#edge}}
    # The edge network for Traefik, the project's own for Postgres; names are prefixed with {{name}}, so they never
    # clash with the other stack's routers.
    networks:
      - edge
      - default
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{edgeNetwork}}"
      - "traefik.http.routers.{{name}}.rule={{appRule}}"
      - "traefik.http.routers.{{name}}.entrypoints=websecure"
      - "traefik.http.routers.{{name}}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.{{name}}.service={{name}}"
      - "traefik.http.routers.{{name}}.middlewares={{name}}-security-headers"
      - "traefik.http.services.{{name}}.loadbalancer.server.port=3000"
      - "traefik.http.middlewares.{{name}}-security-headers.headers.stsSeconds=31536000"
      - "traefik.http.middlewares.{{name}}-security-headers.headers.stsIncludeSubdomains=true"
      - "traefik.http.middlewares.{{name}}-security-headers.headers.contentTypeNosniff=true"
      - "traefik.http.middlewares.{{name}}-security-headers.headers.referrerPolicy=strict-origin-when-cross-origin"
{{#www}}
      - "traefik.http.routers.{{name}}-www.rule=Host(`www.{{domain}}`)"
      - "traefik.http.routers.{{name}}-www.entrypoints=websecure"
      - "traefik.http.routers.{{name}}-www.tls.certresolver=letsencrypt"
      - "traefik.http.routers.{{name}}-www.service=noop@internal"
      - "traefik.http.routers.{{name}}-www.middlewares={{name}}-www-to-apex"
      - "traefik.http.middlewares.{{name}}-www-to-apex.redirectregex.regex=^https?://www\\.{{domainPattern}}/(.*)"
      - "traefik.http.middlewares.{{name}}-www-to-apex.redirectregex.replacement=https://{{domain}}/$${1}"
      - "traefik.http.middlewares.{{name}}-www-to-apex.redirectregex.permanent=true"
{{/www}}
{{/edge}}
{{#worker}}

  # The job worker (@softure-ai/jobs): the same image running `node worker.mjs`, with the app's environment. It
  # serves no HTTP, so the image's health check (which asks the app's port) is replaced by a liveness check of PID 1
  # (`node worker.mjs`): `docker compose up --wait` fails on a service whose check is disabled. On a deploy it gets
  # SIGTERM, lets running jobs finish for the module's shutdownGraceMs (20 s by default) and releases the rest; the
  # stop grace period below leaves it that time before Docker kills it.
  worker:
    image: {{image}}:${TAG}
    restart: unless-stopped
    command: ["node", "worker.mjs"]
    environment:
      APP_ORIGIN: https://{{domain}}
      DATABASE_URL: postgresql://softure_app:${SOFTURE_APP_PASSWORD:?}@postgres:5432/{{databaseName}}
{{#hasAppEnv}}
{{appEnvLines}}
{{/hasAppEnv}}
    healthcheck:
      test: ["CMD", "node", "-e", "process.kill(1, 0)"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    stop_grace_period: 30s
    depends_on:
      migrate:
        condition: service_completed_successfully
{{/worker}}
{{#database}}

  # One-off: applies the migrations of the new image as the migrator role before the app starts. A failed
  # migration stops the deploy here; the old app container keeps serving.
  migrate:
    image: {{image}}:${TAG}
    command: ["node", "migrate.mjs", "--migrations-dir", "./softure-migrations"]
    environment:
      DATABASE_URL: postgresql://softure_migrator:${SOFTURE_MIGRATOR_PASSWORD:?}@postgres:5432/{{databaseName}}
    depends_on:
      postgres:
        condition: service_healthy
    restart: "no"

  # initdb/ creates the migrator and app roles on the first start (the @softure-ai/ops recipe). The port is
  # published on loopback only, for deploy.sh's backup, schema guard and row counts on the host.
  postgres:
    image: postgres:{{postgresVersion}}
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?}
      POSTGRES_DB: {{databaseName}}
      SOFTURE_MIGRATOR_PASSWORD: ${SOFTURE_MIGRATOR_PASSWORD:?}
      SOFTURE_APP_PASSWORD: ${SOFTURE_APP_PASSWORD:?}
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./initdb:/docker-entrypoint-initdb.d:ro
    healthcheck:
      # Over TCP: during initdb the image runs a temporary server on the socket only.
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U postgres -d {{databaseName}}"]
      interval: 2s
      timeout: 5s
      retries: 30
{{/database}}
{{^edge}}

volumes:
  letsencrypt:
{{#database}}
  postgres-data:
{{/database}}
{{/edge}}
{{#edge}}
{{#database}}

volumes:
  postgres-data:
{{/database}}

networks:
  edge:
    name: {{edgeNetwork}}
    external: true
{{/edge}}
