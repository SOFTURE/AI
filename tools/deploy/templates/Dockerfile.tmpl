# The production image of {{name}}, generated by `softure-deploy init` (@softure-ai/deploy {{cliVersion}}).
# The app owns this file now: change it freely; init never overwrites it without --force.
#
# The container recipe of @softure-ai/ops: a Next standalone build, a non-root user and the health check in
# the image itself, so it travels to every place the image runs.
{{#database}}
# One image, two roles: `node server.js` serves the app, `node migrate.mjs` applies the module migrations
# once before the app starts (the `migrate` service of docker/prod/docker-compose.yml).
{{/database}}
#
# next.config must build `output: "standalone"`; BUILD_STANDALONE=1 below is set for configs that switch on it.
ARG NODE_IMAGE=node:22-alpine

FROM ${NODE_IMAGE} AS builder
WORKDIR /app
# The whole context before `npm ci`, so `file:` dependencies (vendored tarballs, local packages) resolve; the
# npm cache mount keeps a reinstall fast. `CI=true` skips git hook installs (`prepare`): the image has no git.
COPY . .
RUN --mount=type=cache,target=/root/.npm CI=true npm ci --no-audit --no-fund
ENV NEXT_TELEMETRY_DISABLED=1
ENV BUILD_STANDALONE=1
# Server action IDs change with every build unless this key is the same for every build. An app that runs
# instances from different builds passes it as a build secret:
#   RUN --mount=type=secret,id=actions_key,env=NEXT_SERVER_ACTIONS_ENCRYPTION_KEY npm run build
RUN npm run build
{{#database}}

# The migrate runner: module SQL copied out of the packages (a bundle cannot find package folders), then
# scripts/migrate.ts bundled with pg left external (the standalone server ships it). drizzle's driver adapters stay
# external too: bundled, the adapter of a driver the app does not install would fail migrate.mjs at start.
RUN npx softure migrate --export-migrations ./softure-migrations \
 && npx --yes esbuild@{{esbuildVersion}} scripts/migrate.ts --bundle --platform=node --format=esm --target=node22 \
      --external:pg --external:@electric-sql/pglite \
      --external:drizzle-orm/pglite --external:drizzle-orm/node-postgres --outfile=migrate.mjs

# Ops scripts: every scripts/ops/<name>.ts but tests becomes ops/<name>.mjs, bundled like migrate.mjs. On the server
# `softure-deploy run <name>` runs it in the app container (deploy.sh's `run`); no script code travels over SSH.
RUN mkdir -p ops \
 && entries="$(find scripts/ops -maxdepth 1 -name '*.ts' ! -name '*.test.ts' 2> /dev/null || true)" \
 && if [ -n "$entries" ]; then \
      npx --yes esbuild@{{esbuildVersion}} $entries --bundle --platform=node --format=esm --target=node22 \
        --external:pg --external:@electric-sql/pglite \
        --external:drizzle-orm/pglite --external:drizzle-orm/node-postgres --outdir=ops --out-extension:.js=.mjs; \
    fi
{{/database}}

FROM ${NODE_IMAGE} AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
# 0.0.0.0, not localhost: otherwise the server listens only inside the container.
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 --ingroup nodejs nextjs

# Root-owned and read-only for the app user: the process cannot rewrite its own code.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
{{#publicDir}}
COPY --from=builder /app/public ./public
{{/publicDir}}
{{#database}}
COPY --from=builder /app/migrate.mjs ./migrate.mjs
COPY --from=builder /app/softure-migrations ./softure-migrations
COPY --from=builder /app/ops ./ops
{{/database}}

USER nextjs
EXPOSE 3000

# `node -e` because alpine has no curl.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('node:http').get('http://127.0.0.1:3000{{healthPath}}',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "server.js"]
