# Release of {{name}}, generated by `softure-deploy init` (@softure-ai/deploy {{cliVersion}}). It calls SOFTURE/AI's
# reusable release workflow (deploy-cut-release.yml); the app owns this file now.
#
# "Run workflow" on the default branch cuts the next date tag (vYYYY.MM.DD, then -2, -3) and its GitHub Release on
# that commit, then starts `deploy.yml` on the tag: the owner can run it from the Actions tab, and an agent that cannot
# push tags can start it as a workflow_dispatch. The tag's date is taken in `timezone` (Europe/Warsaw for a Polish
# day). SOFTURE/AI's workflows are called at {{workflowsRef}}; pin a commit SHA for an immutable reference, best the
# commit of the release tag deploy@{{cliVersion}}, the same one deploy.yml pins.

name: release

on:
  workflow_dispatch:
    inputs:
      description:
        description: Markdown above the generated release notes (optional)
        type: string
        required: false
        default: ""

# The tag and the release, and starting deploy.yml on the tag.
permissions:
  contents: write
  actions: write

jobs:
  release:
    uses: SOFTURE/AI/.github/workflows/deploy-cut-release.yml@{{workflowsRef}}
    with:
      description: ${{ inputs.description }}
      timezone: UTC
      deploy-workflow: deploy.yml
