# Release notes of {{name}}, generated by `softure-deploy init` (@softure-ai/deploy {{cliVersion}}). It calls
# SOFTURE/AI's reusable release-notes workflow (deploy-release-notes.yml); the app owns this file now.
#
# "Run workflow" with a tag and a body replaces that release's body above its softure-deploy sections (untick
# keep-report to replace all of it): the owner can run it from the Actions tab, and an agent that cannot edit a
# release through the API can start it as a workflow_dispatch.
{{#workflowsPinned}}
# SOFTURE/AI's workflows are pinned to commit {{workflowsRef}} (--workflows-ref); move every
# caller's `uses:` together to the commit of the new release tag when the app upgrades @softure-ai/deploy.
{{/workflowsPinned}}
{{^workflowsPinned}}
# SOFTURE/AI's workflows are called at `master`; pin a commit SHA for an immutable reference, best the commit of the
# release tag deploy@{{cliVersion}}, the same one deploy.yml pins.
{{/workflowsPinned}}
name: release-notes

on:
  workflow_dispatch:
    inputs:
      tag:
        description: The tag of the release to edit
        type: string
        required: true
      body:
        description: The new release body (markdown); with keep-report, the text above the softure-deploy sections
        type: string
        required: true
      keep-report:
        description: Keep the release's softure-deploy sections (what's in, status, deployments) below the new body
        type: boolean
        required: false
        default: true

# Editing the release.
permissions:
  contents: write

jobs:
  notes:
    uses: SOFTURE/AI/.github/workflows/deploy-release-notes.yml@{{workflowsRef}}
    with:
      tag: ${{ inputs.tag }}
      body: ${{ inputs.body }}
      keep-report: ${{ inputs.keep-report }}
