# Release notes of {{name}}, generated by `softure-deploy init` (@softure-ai/deploy {{cliVersion}}). It calls
# SOFTURE/AI's reusable release-notes workflow (deploy-release-notes.yml); the app owns this file now.
#
# "Run workflow" with a tag and a body replaces that release's body: the owner can run it from the Actions tab, and an
# agent that cannot edit a release through the API can start it as a workflow_dispatch. SOFTURE/AI's workflows are
# called at {{workflowsRef}}; pin a commit SHA for an immutable reference, the same one deploy.yml pins.
name: release-notes

on:
  workflow_dispatch:
    inputs:
      tag:
        description: The tag of the release to edit
        type: string
        required: true
      body:
        description: The new release body (markdown); it replaces the whole body
        type: string
        required: true

# Editing the release.
permissions:
  contents: write

jobs:
  notes:
    uses: SOFTURE/AI/.github/workflows/deploy-release-notes.yml@{{workflowsRef}}
    with:
      tag: ${{ inputs.tag }}
      body: ${{ inputs.body }}
