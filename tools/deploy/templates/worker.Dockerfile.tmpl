# The job worker's own image of {{name}} ({{workerImageName}}), generated by `softure-deploy init --worker-dockerfile`
# (@softure-ai/deploy {{cliVersion}}). The app owns this file now: change it freely; init never overwrites it without
# --force. deploy-app.yml builds it from the same context and tag as the app's Dockerfile and pushes it with the release
# tag; the `worker` service of docker/prod/docker-compose.yml runs it as `node worker.mjs`.
#
# The base carries what the worker needs and the app image should not (ffmpeg, a headless browser, fonts). Build it
# from the Dockerfile the package that needs those tools ships (for footage films, @softure-ai/marketing-kit's
# docker/footage-worker.Dockerfile, Debian trixie with Node 22), push it, and name it here or in the build-args of the
# caller workflow (WORKER_BASE_IMAGE=<registry/name>@sha256:<digest>). The base must have Node 22 and glibc: the builder
# below installs the native modules for Debian, not alpine.
ARG WORKER_BASE_IMAGE=node:22-trixie-slim

FROM node:22-trixie-slim AS builder
WORKDIR /app
# The whole context before `npm ci`, like the app's Dockerfile; `CI=true` skips git hook installs.
COPY . .
RUN --mount=type=cache,target=/root/.npm CI=true npm ci --no-audit --no-fund
# scripts/worker.ts bundled like the app image's worker.mjs; pg and the drizzle driver adapters stay external and come
# from node_modules below.
RUN mkdir -p .esbuild && printf 'export {};\n' > .esbuild/empty.mjs \
 && npx --yes esbuild@{{esbuildVersion}} scripts/worker.ts --bundle --platform=node --format=esm --target=node22 \
      --alias:server-only=./.esbuild/empty.mjs \
      --banner:js="import { createRequire as __bundleCreateRequire } from 'module'; const require = __bundleCreateRequire(import.meta.url);" \
      --external:pg --external:@electric-sql/pglite \
      --external:drizzle-orm/pglite --external:drizzle-orm/node-postgres --outfile=worker.mjs \
 && npm prune --omit=dev --no-audit --no-fund

FROM ${WORKER_BASE_IMAGE} AS runner
WORKDIR /app
ENV NODE_ENV=production

# The same user as the app image (uid 1001), so both write the data volume as one owner.
RUN (getent group 1001 > /dev/null || groupadd --system --gid 1001 nodejs) \
 && (getent passwd 1001 > /dev/null || useradd --system --uid 1001 --gid 1001 --no-create-home worker)

# Root-owned and read-only for the worker user: the process cannot rewrite its own code.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/worker.mjs ./worker.mjs
{{#dataVolume}}
# The data volume's folder (init --data-volume), owned by the worker user like in the app image.
RUN mkdir -p {{dataPath}} && chown 1001:1001 {{dataPath}}
{{/dataVolume}}

USER 1001
# The compose file's health check replaces this one; it asks the worker's loop, not a port.
HEALTHCHECK NONE

CMD ["node", "worker.mjs"]
