// The job worker of the production image, generated by `softure-deploy init` because the app depends on
// @softure-ai/jobs. The Dockerfile bundles this file into worker.mjs; the `worker` service runs it next to the app:
// `node worker.mjs`. It stops gracefully on SIGTERM (a deploy), releasing the jobs it could not finish in time.
//
// The app owns this file: point the import below at its handlers, one per queue of `jobs({ queues })`.
import { runJobWorkerProcess } from "@softure-ai/jobs/worker";
import config from "../softure.config";
import { handlers } from "../src/jobs/handlers";

await runJobWorkerProcess({ config, handlers });
