# The weekly check of the off-site backup of {{name}}, generated by `softure-deploy init --host=cloudflare`
# (@softure-ai/deploy {{cliVersion}}); the app owns this file now. It downloads the newest encrypted dump with the
# read-only token, restores it into a throwaway Postgres on the runner, runs the schema guard against the migrations of
# the default branch and counts the rows of deploy.json's database.rowCountTables, then drops it. A copy older than 26
# hours, one that does not decrypt or restore, or a failed guard fails the run.
#
# A failed run opens an issue labelled `backup-verify` (or comments on the open one) with the run's link, assigned to
# the repository's owner, and the next green run closes it. GitHub itself mails a failed scheduled run only to whoever
# last edited the cron line, so without the issue a red run stays unseen.
#
# Settings live in the GitHub Environment `backup-verify`, which only this workflow uses (never the deploy's):
#   variables: BACKUP_S3_ENDPOINT, BACKUP_S3_REGION, BACKUP_S3_BUCKET, BACKUP_S3_PREFIX
#   secrets:   BACKUP_S3_READ_ACCESS_KEY_ID, BACKUP_S3_READ_SECRET_ACCESS_KEY (the read-only token)
#              BACKUP_AGE_IDENTITY (the age private key, AGE-SECRET-KEY-1…)
name: backup verify

on:
  schedule:
    # Monday 05:40 UTC, after the night's backup.yml (03:17 UTC) has uploaded.
    - cron: "40 5 * * 1"
  workflow_dispatch:

permissions:
  contents: read
  # The issue that reports a failed check.
  issues: write

jobs:
  verify:
    runs-on: ubuntu-latest
    environment: backup-verify
    timeout-minutes: 60
    services:
      postgres:
        # pg_restore must be at least as new as the pg_dump that wrote the copy (backup.yml's postgres-major).
        image: postgres:{{cloudflarePostgresMajor}}
        env:
          POSTGRES_PASSWORD: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: actions/setup-node@v6
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      # The migrations the app ships, for the schema guard (a VPS copies them out of its image instead).
      - run: npx softure migrate --export-migrations ./softure-migrations
      - name: PostgreSQL tools
        run: |
          cat > "$RUNNER_TEMP/pg_restore" <<'WRAPPER'
          #!/usr/bin/env bash
          exec docker run --rm -i --network host -e PGHOST -e PGPORT -e PGUSER -e PGPASSWORD -e PGDATABASE postgres:{{cloudflarePostgresMajor}} pg_restore "$@"
          WRAPPER
          chmod +x "$RUNNER_TEMP/pg_restore"
          echo "BACKUP_PG_RESTORE=$RUNNER_TEMP/pg_restore" >> "$GITHUB_ENV"
      - name: Verify the newest off-site copy
        env:
          BACKUP_S3_ENDPOINT: ${{ vars.BACKUP_S3_ENDPOINT }}
          BACKUP_S3_REGION: ${{ vars.BACKUP_S3_REGION }}
          BACKUP_S3_BUCKET: ${{ vars.BACKUP_S3_BUCKET }}
          BACKUP_S3_PREFIX: ${{ vars.BACKUP_S3_PREFIX }}
          BACKUP_S3_READ_ACCESS_KEY_ID: ${{ secrets.BACKUP_S3_READ_ACCESS_KEY_ID }}
          BACKUP_S3_READ_SECRET_ACCESS_KEY: ${{ secrets.BACKUP_S3_READ_SECRET_ACCESS_KEY }}
          BACKUP_AGE_IDENTITY: ${{ secrets.BACKUP_AGE_IDENTITY }}
          BACKUP_VERIFY_DATABASE_URL: postgresql://postgres:postgres@localhost:5432/postgres
        # The key goes in on stdin, never as an argument.
        run: |
          printf '%s\n' "$BACKUP_AGE_IDENTITY" \
            | npx --yes --package=@softure-ai/backup@{{backupCliVersion}} softure-backup verify --app={{name}} --identity=- --config=deploy.json --migrations-dir=softure-migrations
      # A red run becomes an issue: one open issue per failure streak, assigned to the owner (an organisation cannot be
      # assigned, then it is opened without), so it reaches notifications and the issue count.
      - name: Report the failed check
        if: failure()
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          OWNER: ${{ github.repository_owner }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          gh label create backup-verify --force --color B60205 --description "The weekly off-site backup check failed"
          body="The weekly off-site backup check failed: $RUN_URL"
          open="$(gh issue list --label backup-verify --state open --limit 1 --json number --jq '.[0].number // empty')"
          if [ -n "$open" ]; then
            gh issue comment "$open" --body "$body"
          elif ! gh issue create --title "Backup verify failed" --label backup-verify --assignee "$OWNER" --body "$body"; then
            gh issue create --title "Backup verify failed" --label backup-verify --body "$body"
          fi
      - name: Close the reports of earlier failures
        if: success()
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          for number in $(gh issue list --label backup-verify --state open --limit 100 --json number --jq '.[].number'); do
            gh issue close "$number" --comment "The weekly off-site backup check is green again: $RUN_URL"
          done
