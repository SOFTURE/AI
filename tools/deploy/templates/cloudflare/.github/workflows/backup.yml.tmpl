# The nightly off-site backup of {{name}} on Cloudflare Workers, generated by `softure-deploy init --host=cloudflare`
# (@softure-ai/deploy {{cliVersion}}). It runs SOFTURE/AI's backup-cloudflare action; the app owns this file now.
#
# The same copy a VPS takes in deploy.sh maintain: pg_dump of the managed Postgres, encrypted with age to
# BACKUP_AGE_RECIPIENT, uploaded with a write-only token, recorded in backup.runs for the app's status screen and
# gauges. Without BACKUP_S3_BUCKET it records `not_configured` and succeeds. The weekly restore check is
# backup-verify.yml. Settings, all in the GitHub Environment `production`:
#   variables: BACKUP_S3_ENDPOINT, BACKUP_S3_REGION, BACKUP_S3_BUCKET, BACKUP_S3_PREFIX, BACKUP_AGE_RECIPIENT
#   secrets:   BACKUP_S3_ACCESS_KEY_ID, BACKUP_S3_SECRET_ACCESS_KEY (the write-only token), MIGRATE_DATABASE_URL
{{#workflowsPinned}}
# SOFTURE/AI's action is pinned to commit {{workflowsRef}} (--workflows-ref).
{{/workflowsPinned}}
{{^workflowsPinned}}
# SOFTURE/AI's action is called at `master`; pin a commit SHA for an immutable reference (--workflows-ref).
{{/workflowsPinned}}

name: backup

on:
  schedule:
    - cron: "17 3 * * *"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  backup:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    environment: production
    concurrency:
      group: backup-production
      cancel-in-progress: false
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: actions/setup-node@v6
        with:
          node-version: 22
      - uses: SOFTURE/AI/.github/actions/backup-cloudflare@{{workflowsRef}}
        env:
          BACKUP_S3_ENDPOINT: ${{ vars.BACKUP_S3_ENDPOINT }}
          BACKUP_S3_REGION: ${{ vars.BACKUP_S3_REGION }}
          BACKUP_S3_BUCKET: ${{ vars.BACKUP_S3_BUCKET }}
          BACKUP_S3_PREFIX: ${{ vars.BACKUP_S3_PREFIX }}
          BACKUP_AGE_RECIPIENT: ${{ vars.BACKUP_AGE_RECIPIENT }}
          BACKUP_S3_ACCESS_KEY_ID: ${{ secrets.BACKUP_S3_ACCESS_KEY_ID }}
          BACKUP_S3_SECRET_ACCESS_KEY: ${{ secrets.BACKUP_S3_SECRET_ACCESS_KEY }}
        with:
          app: {{name}}
          # The direct URL of the migrator role, which owns backup.runs; the Worker goes through Hyperdrive.
          database-url: ${{ secrets.MIGRATE_DATABASE_URL }}
          # pg_dump must be at least as new as the server: set the managed Postgres's major version.
          postgres-major: "{{cloudflarePostgresMajor}}"
          backup-cli-version: {{backupCliVersion}}
