# Release of {{name}} to Cloudflare Workers, generated by `softure-deploy init --host=cloudflare` (@softure-ai/deploy
# {{cliVersion}}). It runs SOFTURE/AI's deploy-cloudflare action; the app owns this file now.
#
# A published GitHub Release deploys its tag; "Run workflow" deploys an existing tag again. Only a tag whose commit is
# on the default branch deploys. The action builds with OpenNext, migrates the database from the runner, deploys the
# Worker with its secrets as one version, verifies deploy.json and rolls back to the previous version when verify fails.
{{#workflowsPinned}}
# SOFTURE/AI's action is pinned to commit {{workflowsRef}} (--workflows-ref); move it to the commit of the new release
# tag when the app upgrades @softure-ai/deploy.
{{/workflowsPinned}}
{{^workflowsPinned}}
# SOFTURE/AI's action is called at `master`; pin a commit SHA for an immutable reference, best the commit of the
# release tag deploy@{{cliVersion}}:
# git ls-remote https://github.com/SOFTURE/AI 'refs/tags/deploy@{{cliVersion}}^{}' (init takes it as --workflows-ref).
{{/workflowsPinned}}

name: deploy

on:
  release:
    types: [published]
  workflow_dispatch:
    inputs:
      tag:
        description: Existing release tag to deploy
        type: string
        required: true

permissions:
  contents: read

jobs:
  # The job runs in the `production` environment, so its secrets and variables are the environment's over the
  # repository's, and the environment's deployment policy and reviewers apply. Every secret reaches the action by
  # name, never as the whole `secrets` context.
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment: production
    # One deploy at a time; a running deploy is never cancelled halfway.
    concurrency:
      group: deploy-production
      cancel-in-progress: false
    steps:
      - uses: actions/checkout@v7
        with:
          ref: ${{ github.event.release.tag_name || inputs.tag }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@v6
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - uses: SOFTURE/AI/.github/actions/deploy-cloudflare@{{workflowsRef}}
{{#hasSecretNames}}
        # Every secret wrangler.jsonc requires (secrets.required), one line each, also listed in secret-names.
        env:
{{secretEnvLines}}
{{/hasSecretNames}}
        with:
          tag: ${{ github.event.release.tag_name || inputs.tag }}
          release-branch: ${{ github.event.repository.default_branch }}
          app-url: https://{{domain}}
          api-token: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          account-id: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
{{#database}}
          # The direct Postgres URL of the migrator role, used on the runner only; the Worker goes through Hyperdrive.
          migrate-database-url: ${{ secrets.MIGRATE_DATABASE_URL }}
{{/database}}
{{#hasSecretNames}}
          # Only these names reach the Worker: {{secretNames}}.
          secret-names: {{secretNameList}}
{{/hasSecretNames}}
          deploy-cli-version: {{cliVersion}}
          environment: production

  # The run's deploy-report artifact into the tag's GitHub Release.
  report:
    needs: deploy
    if: ${{ always() }}
    permissions:
      contents: write
    uses: SOFTURE/AI/.github/workflows/deploy-report.yml@{{workflowsRef}}
    with:
      tag: ${{ github.event.release.tag_name || inputs.tag }}
