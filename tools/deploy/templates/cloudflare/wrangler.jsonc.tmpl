// The Worker of {{name}}, generated by `softure-deploy init --host=cloudflare` (@softure-ai/deploy {{cliVersion}}).
// The app owns this file now. Secrets never go here: the deploy workflow uploads them with the code
// (`wrangler deploy --secrets-file`), and `secrets.required` makes wrangler refuse a deploy that misses one.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{name}}",
{{#database}}
  // OpenNext's handler inside the request database, the generated worker.ts.
{{/database}}
  "main": "{{main}}",
  "compatibility_date": "{{compatibilityDate}}",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [{ "pattern": "{{domain}}", "custom_domain": true }],
  "observability": { "enabled": true },
{{#hasPlacementRegion}}
  // Next to the database's cloud region (--placement-region).
  "placement": { "region": "{{placementRegion}}" },
{{/hasPlacementRegion}}
{{^hasPlacementRegion}}
  // Smart Placement moves the Worker towards the database once it sees traffic; with a managed Postgres in a known
  // region, an explicit hint is faster from the first request: "placement": { "region": "aws:eu-central-1" }.
  "placement": { "mode": "smart" },
{{/hasPlacementRegion}}
{{#database}}
  // Postgres through Hyperdrive (docs/07-runtime-providers.md): the Worker reads env.HYPERDRIVE.connectionString.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "{{hyperdriveId}}" }],
{{/database}}
{{#worker}}
  // The jobs tick (@softure-ai/jobs/workers): one firing a minute runs what is due.
  "triggers": { "crons": ["* * * * *"] },
{{/worker}}
  "vars": { "APP_ORIGIN": "https://{{domain}}" },
  "secrets": { "required": [{{secretsRequiredJson}}] }
}
