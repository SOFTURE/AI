import { withRequestDatabase } from "@softure-ai/db/request";
{{#worker}}
import { createScheduledHandler } from "@softure-ai/jobs/workers";
{{/worker}}
// @ts-expect-error: written by the OpenNext build (`opennextjs-cloudflare build`)
import handler from "./.open-next/worker.js";
{{#worker}}
import config from "./softure.config";
import { handlers } from "./src/jobs/handlers";
{{/worker}}

interface Env {
  readonly HYPERDRIVE: { readonly connectionString: string };
}

interface WorkerContext {
  waitUntil(promise: Promise<unknown>): void;
}

export default {
  fetch(request: Request, env: Env, ctx: WorkerContext): Promise<Response> {
    return withRequestDatabase({ url: env.HYPERDRIVE.connectionString, waitUntil: (promise) => ctx.waitUntil(promise) }, () =>
      handler.fetch(request, env, ctx),
    );
  },
{{#worker}}
  scheduled: createScheduledHandler<Env>({ config, handlers, databaseUrl: (env) => env.HYPERDRIVE.connectionString }),
{{/worker}}
};

