{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "timezone": {
          "type": "string"
        },
        "logo": {
          "type": "object",
          "properties": {
            "svg": {
              "type": "string",
              "minLength": 1,
              "format": "ends_with",
              "pattern": ".*\\.svg$",
              "description": "A path relative to the folder of marketing.json."
            }
          },
          "required": [
            "svg"
          ],
          "additionalProperties": false
        },
        "colors": {
          "default": {},
          "type": "object",
          "properties": {
            "background": {
              "type": "string"
            },
            "foreground": {
              "type": "string"
            },
            "muted": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "cta": {
              "type": "string"
            },
            "onCta": {
              "type": "string"
            },
            "captionBackground": {
              "type": "string"
            },
            "captionText": {
              "type": "string"
            },
            "captionHighlight": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "tokensFrom": {
          "type": "object",
          "properties": {
            "css": {
              "type": "string",
              "minLength": 1,
              "description": "A path relative to the folder of marketing.json."
            },
            "designJson": {
              "type": "string",
              "minLength": 1,
              "description": "A path relative to the folder of marketing.json."
            },
            "theme": {
              "default": "dark",
              "type": "string",
              "enum": [
                "light",
                "dark"
              ]
            },
            "roles": {
              "default": {},
              "type": "object",
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "foreground": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "muted": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "cta": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "onCta": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "captionBackground": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "captionText": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "captionHighlight": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "fonts": {
          "default": {},
          "type": "object",
          "properties": {
            "heading": {
              "type": "object",
              "properties": {
                "family": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*$"
                },
                "fallback": {
                  "default": "sans-serif",
                  "type": "string",
                  "enum": [
                    "serif",
                    "sans-serif",
                    "monospace",
                    "system-ui"
                  ]
                },
                "files": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\.(?:woff2|woff|ttf|otf)$",
                        "description": "A path relative to the folder of marketing.json."
                      },
                      "weight": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000
                          },
                          {
                            "type": "string",
                            "pattern": "^\\d{1,4}( \\d{1,4})?$"
                          }
                        ]
                      },
                      "style": {
                        "default": "normal",
                        "type": "string",
                        "enum": [
                          "normal",
                          "italic"
                        ]
                      },
                      "unicodeRange": {
                        "type": "string",
                        "pattern": "^U\\+[0-9A-Fa-f?]{1,6}(-[0-9A-Fa-f]{1,6})?(, ?U\\+[0-9A-Fa-f?]{1,6}(-[0-9A-Fa-f]{1,6})?)*$"
                      }
                    },
                    "required": [
                      "path",
                      "weight"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "family"
              ],
              "additionalProperties": false
            },
            "body": {
              "type": "object",
              "properties": {
                "family": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*$"
                },
                "fallback": {
                  "default": "sans-serif",
                  "type": "string",
                  "enum": [
                    "serif",
                    "sans-serif",
                    "monospace",
                    "system-ui"
                  ]
                },
                "files": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\.(?:woff2|woff|ttf|otf)$",
                        "description": "A path relative to the folder of marketing.json."
                      },
                      "weight": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000
                          },
                          {
                            "type": "string",
                            "pattern": "^\\d{1,4}( \\d{1,4})?$"
                          }
                        ]
                      },
                      "style": {
                        "default": "normal",
                        "type": "string",
                        "enum": [
                          "normal",
                          "italic"
                        ]
                      },
                      "unicodeRange": {
                        "type": "string",
                        "pattern": "^U\\+[0-9A-Fa-f?]{1,6}(-[0-9A-Fa-f]{1,6})?(, ?U\\+[0-9A-Fa-f?]{1,6}(-[0-9A-Fa-f]{1,6})?)*$"
                      }
                    },
                    "required": [
                      "path",
                      "weight"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "family"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "locale",
        "timezone"
      ],
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "startCommand": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "colorScheme": {
          "default": "light",
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "hideSelectors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!.*\\/\\*)[^{};<>\\\\]+$"
          }
        },
        "screenGuardSelector": {
          "default": "body",
          "type": "string",
          "pattern": "^(?!.*\\/\\*)[^{};<>\\\\]+$"
        },
        "device": {
          "type": "object",
          "properties": {
            "viewport": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4000
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "scale": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            },
            "mobile": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "viewport",
            "scale"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "baseUrl",
        "port",
        "startCommand",
        "device"
      ],
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "provider": {
          "default": "elevenlabs",
          "type": "string",
          "enum": [
            "elevenlabs"
          ]
        },
        "voiceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "default": "eleven_multilingual_v2",
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "tempo": {
          "default": 1,
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.3
        },
        "cacheDir": {
          "default": "marketing/voiceover",
          "type": "string",
          "minLength": 1,
          "description": "A path relative to the folder of marketing.json."
        }
      },
      "required": [
        "voiceId",
        "language"
      ],
      "additionalProperties": false
    },
    "videos": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^\\/.*"
          },
          "format": {
            "default": "9:16",
            "type": "string",
            "enum": [
              "9:16"
            ]
          },
          "device": {
            "type": "object",
            "properties": {
              "viewport": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2000
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4000
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "scale": {
                "type": "number",
                "minimum": 1,
                "maximum": 4
              },
              "mobile": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "viewport",
              "scale"
            ],
            "additionalProperties": false
          },
          "voice": {
            "type": "object",
            "properties": {
              "voiceId": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "tempo": {
                "type": "number",
                "minimum": 0.8,
                "maximum": 1.3
              }
            },
            "additionalProperties": false
          },
          "persona": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "age": {
                "type": "integer",
                "minimum": 0,
                "maximum": 150
              },
              "tagline": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "age",
              "tagline"
            ],
            "additionalProperties": false
          },
          "beats": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "hook": {
            "type": "object",
            "properties": {
              "still": {
                "type": "string",
                "minLength": 1
              },
              "shots": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "mark": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 4
                    },
                    "word": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "mark",
                    "scale"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "still",
              "shots"
            ],
            "additionalProperties": false
          },
          "screenGuard": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "endCard": {
            "type": "object",
            "properties": {
              "headline": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "headline",
              "url"
            ],
            "additionalProperties": false
          },
          "sceneModule": {
            "type": "string",
            "minLength": 1,
            "description": "A path relative to the folder of marketing.json."
          }
        },
        "required": [
          "id",
          "title",
          "path",
          "persona",
          "beats",
          "hook",
          "screenGuard",
          "endCard",
          "sceneModule"
        ],
        "additionalProperties": false
      }
    },
    "social": {
      "type": "object",
      "properties": {
        "linkTemplate": {
          "type": "string"
        },
        "platforms": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "instagram",
              "facebook",
              "tiktok",
              "youtube",
              "linkedin",
              "x"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 32,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              },
              "linkInBio": {
                "type": "boolean"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        },
        "posts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "video": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "caption": {
                "type": "string"
              },
              "hashtags": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "codes": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "instagram",
                    "facebook",
                    "tiktok",
                    "youtube",
                    "linkedin",
                    "x"
                  ]
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 32,
                  "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
                }
              }
            },
            "required": [
              "video",
              "caption"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "linkTemplate",
        "platforms"
      ],
      "additionalProperties": false
    },
    "screenshots": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^\\/.*"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8000
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8000
          },
          "full": {
            "default": false,
            "type": "boolean"
          },
          "expect": {
            "type": "string"
          },
          "motion": {
            "default": "reduce",
            "type": "string",
            "enum": [
              "reduce",
              "no-preference"
            ]
          },
          "minBytes": {
            "default": 40000,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "path",
          "width",
          "height",
          "expect"
        ],
        "additionalProperties": false
      }
    },
    "ogImages": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "size": {
                "default": [
                  1200,
                  630
                ],
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4000
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4000
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "template": {
                "type": "string",
                "const": "headline-cta"
              },
              "data": {
                "type": "object",
                "properties": {
                  "eyebrow": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "headline": {
                    "type": "string",
                    "maxLength": 90
                  },
                  "cta": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "tiles": {
                    "default": [],
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "maxLength": 24
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 16
                        }
                      },
                      "required": [
                        "label",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "headline"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "template",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "size": {
                "default": [
                  1200,
                  630
                ],
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4000
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4000
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "template": {
                "type": "string",
                "const": "headline-chart"
              },
              "data": {
                "type": "object",
                "properties": {
                  "eyebrow": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "headline": {
                    "type": "string",
                    "maxLength": 90
                  },
                  "chart": {
                    "type": "object",
                    "properties": {
                      "viewBox": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "paths": {
                        "minItems": 1,
                        "maxItems": 8,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "d": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 20000,
                              "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE.,+\\-\\s]+$"
                            },
                            "tone": {
                              "default": "accent",
                              "type": "string",
                              "enum": [
                                "accent",
                                "cta",
                                "foreground",
                                "muted"
                              ]
                            },
                            "fill": {
                              "default": false,
                              "type": "boolean"
                            },
                            "strokeWidth": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          },
                          "required": [
                            "d"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "viewBox",
                      "paths"
                    ],
                    "additionalProperties": false
                  },
                  "tiles": {
                    "default": [],
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "maxLength": 24
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 16
                        }
                      },
                      "required": [
                        "label",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "headline",
                  "chart"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "template",
              "data"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "sfx": {
      "default": {},
      "type": "object",
      "properties": {
        "tap": {
          "type": "string",
          "minLength": 1,
          "description": "A path relative to the folder of marketing.json."
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "A path relative to the folder of marketing.json."
        },
        "whoosh": {
          "type": "string",
          "minLength": 1,
          "description": "A path relative to the folder of marketing.json."
        },
        "sparkle": {
          "type": "string",
          "minLength": 1,
          "description": "A path relative to the folder of marketing.json."
        },
        "pop": {
          "type": "string",
          "minLength": 1,
          "description": "A path relative to the folder of marketing.json."
        }
      },
      "additionalProperties": false
    },
    "output": {
      "default": {},
      "type": "object",
      "properties": {
        "dir": {
          "default": "marketing/out",
          "type": "string",
          "minLength": 1,
          "description": "A path relative to the folder of marketing.json."
