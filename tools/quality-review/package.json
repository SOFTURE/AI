{
  "name": "@softure-ai/quality-review",
  "version": "0.1.0",
  "description": "SOFTURE AI quality review: a read-only Claude Agent SDK review of a whole repository against its AGENTS.md, written as a QUALITY-REPORT.md in a fixed format (stable ids, severity, file:line, impact, fix) under a hard cost cap; the CLI behind the reusable quality-review.yml workflow.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "tools/quality-review"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "src",
    "prompt",
    "examples",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "softure-quality-review": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.319"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}
