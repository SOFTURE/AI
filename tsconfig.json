{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.mjs"],
  "exclude": ["**/node_modules", "**/dist", "coverage", ".claude", "examples"]
}
