{
  "mode": "autonomous",
  "timezone": "Europe/Warsaw",
  "language": "en",
  "mainBranch": "master",
  "gates": {
    "typecheck": "npm run typecheck",
    "lint": "npm run lint",
    "test": "npm test"
  },
  "integration": {
    "local": "npm run e2e",
    "remote": null
  },
  "migrations": null,
  "worktree": {
    "setup": [
      "npm ci --include=dev"
    ],
    "maxParallel": 4,
    "cloudState": "branch"
  },
  "release": {
    "owner": false
  },
  "research": {
    "sources": [
      "docs/",
      "../../FIRE_TRACKER/",
      "../SKILLS/",
      "../API/.github/workflows/"
    ]
  },
  "autonomy": {"source": "issues", "merge": "pr", "reports": {"every": 30, "hours": "10:00-22:30"}}
}
