{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softure-example-next-app",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "local", "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5433/softure_example" }],
  "vars": { "SOFTURE_HOST": "cloudflare" }
}
