# Copy to .env.local for `next dev`. The default matches compose.yaml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/softure_example
APP_ORIGIN=http://localhost:3000
# en (default) or pl
APP_LOCALE=en
# Mail: a Resend API key sends real mail; without it the fake provider captures mail to this file.
# RESEND_API_KEY=
MAIL_OUTBOX=/tmp/softure-example-outbox.jsonl
# Signs unsubscribe links of list mail (the newsletter option on /account/mail); 32+ characters,
# e.g. `openssl rand -base64 32`.
MAILING_UNSUBSCRIBE_SECRET=
