{
  "name": "softure-example-next-app",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js app that consumes @softure-ai/core, db, ui, security, auth, ops, feature-switches, mailing, mcp-access, privacy, waitlist, analytics, billing, seo and blog as packed packages; the e2e harness of SOFTURE AI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "migrate": "softure migrate",
    "grant-role": "node scripts/grant-role.ts",
    "revoke-role": "node scripts/revoke-role.ts",
    "grant-plan": "node scripts/grant-plan.ts",
    "revoke-grant": "node scripts/revoke-grant.ts",
    "import-entitlements": "node scripts/import-entitlements.ts",
    "pin-trials": "node scripts/pin-trials.ts",
    "access-reminders": "node scripts/send-access-reminders.ts",
    "expire-invoice-requests": "node scripts/expire-invoice-requests.ts",
    "blog:publish": "node scripts/blog.ts publish",
    "blog:fixtures": "node scripts/blog.ts publish e2e/fixtures/blog-renamed --commit --no-indexnow && node scripts/blog.ts publish --commit --no-indexnow",
    "e2e": "playwright test",
    "e2e:stripe-sandbox": "playwright test --config playwright.stripe-sandbox.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "@softure-ai/analytics": "file:../../modules/analytics",
    "@softure-ai/auth": "file:../../modules/auth",
    "@softure-ai/billing": "file:../../modules/billing",
    "@softure-ai/blog": "file:../../modules/blog",
    "@softure-ai/core": "file:../../foundation/core",
    "@softure-ai/db": "file:../../foundation/db",
    "@softure-ai/feature-switches": "file:../../modules/feature-switches",
    "@softure-ai/mailing": "file:../../modules/mailing",
    "@softure-ai/mcp-access": "file:../../modules/mcp-access",
    "@softure-ai/ops": "file:../../modules/ops",
    "@softure-ai/privacy": "file:../../modules/privacy",
    "@softure-ai/security": "file:../../modules/security",
    "@softure-ai/seo": "file:../../modules/seo",
    "@softure-ai/ui": "file:../../foundation/ui",
    "@softure-ai/waitlist": "file:../../modules/waitlist",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
