{
  "name": "@softure-ai/theme-notion",
  "version": "0.5.0",
  "description": "SOFTURE AI Notion theme: shadcn/ui components (new-york v4, Radix, Tailwind CSS v4, lucide) with the Notion design system's tokens and deltas, ready to import.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOFTURE/AI.git",
    "directory": "themes/theme-notion"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "@softure-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./sft-bridge.css": "./dist/sft-bridge.css",
    "./page.css": "./dist/page.css",
    "./preflight.css": "./dist/preflight.css",
    "./base.css": "./dist/base.css",
    "./maplibre.css": "./dist/maplibre.css"
  },
  "softureTheme": {
    "sources": [
      "./ui",
      "./notion"
    ],
    "imports": [
      "tw-animate-css"
    ],
    "stylesheets": [
      "sft-bridge.css",
      "page.css"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && softure-theme-css",
    "test:visual": "NODE_OPTIONS=--conditions=@softure-ai/source playwright test",
    "test:coverage": "vitest run --root ../.. themes/theme-notion --coverage.enabled --coverage.provider=v8 --coverage.include='themes/theme-notion/src/**' --coverage.reportsDirectory=coverage/theme-notion --coverage.thresholds.statements=90 --coverage.thresholds.branches=90"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@softure-ai/theme-kit": "^0.1.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@softure-ai/ui": "^0.3.4",
    "zod": "^4.6.5"
  }
}
